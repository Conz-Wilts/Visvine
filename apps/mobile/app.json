{
  "expo": {
    "name": "Visvine",
    "slug": "visvine-mobile",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "scheme": "visvine",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visvine.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#78d870"
      },
      "package": "com.visvine.mobile"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
