# ─── apps/mobile/.env template ─────────────────────────────────────────────
# Copy to apps/mobile/.env. Safe to commit-share — no secrets.
#
# Every EXPO_PUBLIC_* value is inlined into the JS bundle shipped to phones,
# so nothing in this file should ever be secret. Use the dev defaults below
# for normal work; switch the values in the "Production" block when you want
# the mobile client to talk to a deployed backend.

# ───────────────────────────────────────────────────────────────────────────
# Backend URL (dev default)
# ───────────────────────────────────────────────────────────────────────────
# Where to reach the Next.js backend.
#   - iOS simulator:    http://localhost:3000
#   - Android emulator: http://10.0.2.2:3000
#   - Physical phone:   http://<your-laptop-LAN-ip>:3000  (next dev must bind to 0.0.0.0)
#                       OR a Cloudflare tunnel URL (see README "Mobile" section)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Enables the "Dev login" button on LoginScreen and the DevLoginScreen route.
# Backend must also have ENABLE_DEV_AUTH=true for the endpoints to respond.
# Set to false (or remove) for a production-pointing build.
EXPO_PUBLIC_DEV_AUTH=true

# Required only when actually using real Google OAuth (not the dev bypass).
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=


# ═══════════════════════════════════════════════════════════════════════════
# Production overrides (swap the values above when targeting prod)
# ═══════════════════════════════════════════════════════════════════════════
# Public origin of the deployed Next.js backend, e.g.
#   EXPO_PUBLIC_API_URL=https://app.visvine.com
# or a Cloudflare tunnel that fronts a local prod-DB-pointing `pnpm dev:cloud`.
#
# In production builds:
#   - EXPO_PUBLIC_DEV_AUTH should be false (the server also 404s those routes
#     when NODE_ENV=production, so this is belt-and-braces).
#   - EXPO_PUBLIC_GOOGLE_CLIENT_ID must be set so the real Google Sign-In
#     flow works on device.
