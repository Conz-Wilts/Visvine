# Production template for the Expo app.
# Copy to apps/mobile/.env when you want the mobile client to talk to a
# deployed (or tunnelled prod-pointing) backend instead of local docker dev.
#
# Reminder: every EXPO_PUBLIC_* value is inlined into the JS bundle shipped
# to phones. Don't put secrets here.

# Public origin of the deployed Next.js backend.
#   - Real deploy:    https://app.visvine.com  (or whatever the prod URL is)
#   - Local prod-DB:  https://<your-tunnel>.trycloudflare.com pointing at
#                     localhost:3000 (your laptop running `pnpm db:proxy:cloud`
#                     + `pnpm --filter @visvine/web dev`)
EXPO_PUBLIC_API_URL=https://app.visvine.com

# Must be false in production. The dev-login button is also gated on the
# backend by NODE_ENV/ENABLE_DEV_AUTH, so even if this is flipped to true the
# server-side endpoints will 404.
EXPO_PUBLIC_DEV_AUTH=false

# Public OAuth client ID for the Google Sign-In flow on mobile.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
