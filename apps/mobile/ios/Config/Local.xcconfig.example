// Copy this file to `Local.xcconfig` (gitignored) and fill in your values.
// It is #include?'d by Base.xcconfig.

// Your Apple Developer Team ID (App Store Connect > Membership). Required to
// archive a signed build for TestFlight / the App Store.
DEVELOPMENT_TEAM = REPLACE_WITH_TEAM_ID

// Optional: real Google OAuth web client id for on-device Google sign-in.
// VISVINE_GOOGLE_CLIENT_ID = xxxxxxxx.apps.googleusercontent.com

// Optional: Debug backend for a physical phone (the Mac's Bonjour name or LAN IP).
// VISVINE_API_BASE_URL = http:/$()/Your-Mac.local:3000
