<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Visvine</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- The web app is light-only; pin system-drawn UI (sheets, keyboard,
         alerts) to light so a phone in dark mode cannot half-repaint the app. -->
    <key>UIUserInterfaceStyle</key>
    <string>Light</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- visvine:// OAuth deep-link callback -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.visvine.mobile.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>visvine</string>
            </array>
        </dict>
    </array>

    <!-- Allow cleartext to the local dev backend (http://localhost:3000). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- App configuration. Driven per-build-configuration from Config/*.xcconfig
         (Debug -> local dev, Release -> production). Do not hardcode here. -->
    <key>VisvineApiBaseURL</key>
    <string>$(VISVINE_API_BASE_URL)</string>
    <key>VisvineDevAuthEnabled</key>
    <string>$(VISVINE_DEV_AUTH_ENABLED)</string>
    <key>VisvineGoogleClientID</key>
    <string>$(VISVINE_GOOGLE_CLIENT_ID)</string>
</dict>
</plist>
