<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Visvine</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- visvine:// OAuth deep-link callback -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.visvine.mobile.auth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>visvine</string>
            </array>
        </dict>
    </array>

    <!-- Allow cleartext to the local dev backend (http://localhost:3000). -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>

    <!-- App configuration (replaces the old EXPO_PUBLIC_* values). -->
    <key>VisvineApiBaseURL</key>
    <string>http://localhost:3000</string>
    <key>VisvineDevAuthEnabled</key>
    <true/>
    <key>VisvineGoogleClientID</key>
    <string></string>
</dict>
</plist>
