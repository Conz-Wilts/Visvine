# Copy this file to `keystore.properties` (gitignored) and fill in your values.
# Generate an upload keystore once with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias visvine-upload
# Google Play App Signing then manages the final app signing key.

storeFile=upload-keystore.jks
storePassword=CHANGEME
keyAlias=visvine-upload
keyPassword=CHANGEME
