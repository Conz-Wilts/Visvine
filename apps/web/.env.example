# ─── apps/web/.env template ────────────────────────────────────────────────
# Copy to apps/web/.env. Safe to commit-share — no real secrets in here.
#
# One file, two modes:
#   • Default (uncommented) values below = local dev against Docker Postgres.
#     `pnpm dev` Just Works after copying this file.
#   • The "Production / Cloud SQL" block at the bottom is commented out.
#     Uncomment it, fill in real values pulled from Secret Manager, and run
#     `pnpm dev:cloud` to point at Cloud SQL via the Auth Proxy.
#
# When switching to prod mode, also change NODE_ENV → production and
# ENABLE_DEV_AUTH → false (or just delete the dev line) so the /dev/login
# routes stop responding.

# ───────────────────────────────────────────────────────────────────────────
# Mode (dev defaults)
# ───────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Enables /dev/login and /api/dev/* dev-only auth bypass.
# In production builds NODE_ENV is "production" and these endpoints return 404
# regardless of this flag.
ENABLE_DEV_AUTH=true

# ───────────────────────────────────────────────────────────────────────────
# Database — dev (Docker Postgres on localhost:5432, see docker-compose.yml)
# ───────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visvine

# ───────────────────────────────────────────────────────────────────────────
# Auth
# ───────────────────────────────────────────────────────────────────────────
# Required by lib/session.ts for HS256 JWT signing.
# Any sufficiently-random string is fine for dev; generate a unique value per
# machine if you prefer (`openssl rand -hex 32`).
# In prod this MUST match whatever AUTH_SECRET was deployed with — rotating
# it invalidates every active session. Pull from Secret Manager.
AUTH_SECRET=dev-secret-not-for-production-replace-me-with-random-32-bytes-please

# ───────────────────────────────────────────────────────────────────────────
# App
# ───────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails treated as super admin (bypass per-community membership).
# The seed creates admin@local.dev — listed here so you don't have to remember.
SUPER_ADMIN_EMAILS=admin@local.dev

# ───────────────────────────────────────────────────────────────────────────
# Optional in dev
# ───────────────────────────────────────────────────────────────────────────
# Set to enable semantic search locally. Without this, falls back to keyword.
# OPENAI_API_KEY=

# Override the seed user count (default 1000).
# SEED_USER_COUNT=500

# Shared dev-fixture bucket (see docs/SETUP.md §6). When set, enables:
#   pnpm db:restore        — pull seed-latest.dump from GCS (skips faker reseed
#                            AND skips OpenAI embedding regen)
#   pnpm db:dump           — local-only snapshot to tmp/fixtures/
#   pnpm db:publish        — maintainer-only: dump + upload as new latest
# Requires `gcloud auth application-default login` on this machine.
# GCS_DUMP_BUCKET=visvine-dev-fixtures


# ═══════════════════════════════════════════════════════════════════════════
# Production / Cloud SQL mode (uncomment + fill in to use)
# ═══════════════════════════════════════════════════════════════════════════
# Pair this with `pnpm db:proxy:cloud` or `pnpm dev:cloud`. The proxy
# authenticates with your gcloud ADC identity and forwards to the instance
# named below. Pull the DB user/password and AUTH_SECRET from Secret Manager.
#
# Remember to also flip NODE_ENV → production and ENABLE_DEV_AUTH → false
# at the top of this file.

# ─── Database (via Cloud SQL Auth Proxy on 127.0.0.1:5432) ─────────────────
# CLOUD_SQL_CONNECTION_NAME=your-gcp-project:your-region:your-instance
# DATABASE_URL=postgresql://PROD_DB_USER:PROD_DB_PASSWORD@127.0.0.1:5432/visvine
#
# Alternatively use discrete parts (lib/prisma.ts honours these if DATABASE_URL
# is not set). Pick one form and stick with it.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=visvine

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Required for real sign-in. Both web and google-mobile callbacks read these.
# Make sure NEXT_PUBLIC_APP_URL/api/auth/callback/google is in the OAuth
# client's authorized redirect URIs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Google Cloud Storage ──────────────────────────────────────────────────
# Production media + resource buckets. Service-account credentials below are
# used by lib/gcs.ts when running outside GCP (e.g. your laptop). Inside GCP
# (Cloud Run, GCE, etc.) prefer the runtime's attached service account and
# leave CLIENT_EMAIL/PRIVATE_KEY unset.
# GCS_PROJECT_ID=
# GCS_MEDIA_BUCKET=
# GCS_RESOURCES_BUCKET=
# GCS_CDN_BASE_URL=
# GCS_CDN_HOSTNAME=
# GCS_CLIENT_EMAIL=
# Paste the JSON private key with literal \n escapes; lib/gcs.ts un-escapes.
# GCS_PRIVATE_KEY=

# ─── Web Push (optional) ───────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@visvine.com

# ─── Google Maps (optional, used by event location picker) ─────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
