# ─── Database (Cloud SQL via proxy) ─────────────────────────────────────────
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5432/DB_NAME
CLOUD_SQL_CONNECTION_NAME=<gcp-project-id>:<region>:<instance-name>
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ─── Admin gating ───────────────────────────────────────────────────────────
# Email address allowed to access /db visualization route (lowercased compare)
DB_ADMIN_EMAIL=admin@example.com

# ─── OpenAI (semantic search + embeddings) ──────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ─── Better Auth ────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# ─── Google Cloud Storage ───────────────────────────────────────────────────
# Required — code fails fast if these are unset
GCS_PROJECT_ID=<gcp-project-id>
GCS_MEDIA_BUCKET=<your-media-bucket>
GCS_RESOURCES_BUCKET=<your-resources-bucket>
# Optional CDN in front of /api/media
GCS_CDN_BASE_URL=

# Service-account credentials (production only — local dev uses ADC via
# `gcloud auth application-default login`)
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# ─── App URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
