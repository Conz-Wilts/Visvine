{
  "extends": "@visvine/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // scripts/fixtures/** holds Tool SOURCE files (`ui.tsx`, `data.js`) that the
  // verify scripts feed to the server-side Tool compiler, not app code: they
  // import `@visvine/tool-kit`, which only resolves through the frame's import
  // map at run time, and one of them is a deliberate syntax error.
  "exclude": ["node_modules", "scripts/fixtures/**"]
}
