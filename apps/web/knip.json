{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.test.ts",
    // The Tool SDK. These four are entry points knip cannot see: the kit is
    // compiled by esbuild into a browser bundle that Tool code imports as
    // `@visvine/tool-kit` (never by the app), `runtime.ts` is loaded by the
    // frame document at run time, and protocol.ts/sdkDocs.ts are the wire
    // contract and the authoring docs — deliberately whole, not trimmed to
    // whichever half of the app has been written so far.
    "features/tools/kit/index.ts",
    "features/tools/kit/runtime.ts",
    "lib/tools/protocol.ts",
    "lib/tools/sdkDocs.ts",
    // The Tool host components. Built in wave 2, mounted in wave 3 (the
    // marketplace and the review queue), so they have no importer yet. Drop
    // these lines as each one gains one — they are a note that the consumer is
    // still to come, not a permanent exemption. (ToolFrame's landed: the
    // `/t/<slug>` page and the preview page mount it. PerimeterSummary's too:
    // the author page shows a Tool's declared reach and asks it again in the
    // publish dialog.)
    "features/tools/components/CodeDiff.tsx"
  ],
  "project": ["app/**", "components/**", "features/**", "lib/**", "scripts/**", "tests/**"],
  "ignoreDependencies": []
}
