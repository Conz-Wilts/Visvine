{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.test.ts",
    // The Tool SDK. These four are entry points knip cannot see: the kit is
    // compiled by esbuild into a browser bundle that Tool code imports as
    // `@visvine/tool-kit` (never by the app), `runtime.ts` is loaded by the
    // frame document at run time, and protocol.ts/sdkDocs.ts are the wire
    // contract and the authoring docs — deliberately whole, not trimmed to
    // whichever half of the app has been written so far.
    "features/tools/kit/index.ts",
    "features/tools/kit/runtime.ts",
    // Kit 1, frozen: built into its own vendor file for the Tools written against it.
    "features/tools/kit/kit1.ts",
    "features/tools/kit/legacyBoot.ts",
    "lib/tools/protocol.ts",
    "lib/tools/sdkDocs.ts"
  ],
  "project": ["app/**", "features/**", "lib/**", "scripts/**", "tests/**"],
  // Tool SOURCE files the verify scripts read off disk and feed to the
  // server-side Tool compiler. Nothing imports them, and nothing should:
  // `@visvine/tool-kit` only resolves through the frame's import map at run
  // time. They are fixtures, not modules. The starting Tools are the same:
  // read as text (scripts/build-tool-templates.ts), typed by their own test.
  "ignore": ["scripts/fixtures/**", "lib/tools/templates/sources/**"],
  // Curated dependencies the vendor build serves to Tools (lib/tools/vendorBundle.ts,
  // @visvine/tool-protocol/dependencies); nothing in the app imports them.
  "ignoreDependencies": [
    "date-fns",
    "lucide-react",
    "motion",
    "@dnd-kit/core",
    "@dnd-kit/sortable",
    "@dnd-kit/utilities",
    "@tanstack/react-table",
    "react-hook-form",
    "papaparse",
    "fuse.js",
    "nanoid"
  ]
}
