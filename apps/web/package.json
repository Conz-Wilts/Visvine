{
  "name": "@visvine/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "knip": "knip --no-progress",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "prisma:generate": "pnpm dlx prisma@7.4.0 generate",
    "prisma:studio": "pnpm dlx prisma@7.4.0 studio",
    "db:push": "pnpm dlx prisma@7.4.0 db push && node scripts/apply-sql-functions.mjs",
    "db:fresh:schema": "node ../../scripts/guard-local-db.mjs && pnpm dlx prisma@7.4.0 db push --force-reset --accept-data-loss && node scripts/apply-sql-functions.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:blackbird:ventures": "node scripts/add-blackbird-ventures.mjs",
    "db:context-links": "tsx scripts/backfill-context-links.ts community:blackbird-ventures",
    "db:note-node-types": "tsx scripts/backfill-note-node-types.ts",
    "db:blackbird:extras": "node scripts/add-blackbird-extras.mjs",
    "db:notes-vault": "node scripts/import-notes-vault.mjs",
    "db:blackbird:notes": "node scripts/add-blackbird-notes.mjs",
    "db:identities:backfill": "tsx scripts/backfill-identities.ts",
    "db:rename-org-to-group": "tsx scripts/rename-organization-to-group.ts",
    "db:context-links:backfill": "tsx scripts/backfill-context-links.ts",
    "db:link-reasons": "tsx scripts/backfill-context-links.ts --reasons",
    "db:entity-context:backfill": "tsx scripts/backfill-entity-context.ts",
    "db:index-notes:backfill": "tsx scripts/backfill-index-notes.ts",
    "db:index-notes:rebuild": "tsx scripts/rebuild-index-notes.ts",
    "db:root-index:backfill": "tsx scripts/backfill-root-index.ts",
    "db:notes:verify": "tsx scripts/verify-notes-rules.ts community:blackbird-ventures",
    "db:embed": "tsx scripts/embed-context.ts",
    "db:connectors:demo": "tsx scripts/add-connector-demo.ts",
    "db:connectors:migrate": "tsx scripts/migrate-connectors-v2.ts",
    "db:connectors:funds": "tsx scripts/add-fund-metrics-demo.ts",
    "connectors:verify:funds": "tsx scripts/verify-fund-metrics-mcp.ts",
    "db:connectors:oauth": "tsx scripts/add-oauth-crm-demo.ts",
    "connectors:verify:oauth": "tsx scripts/verify-oauth-crm-mcp.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@google-cloud/storage": "^7.19.0",
    "@heroicons/react": "^2.2.0",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-table": "3.26.0",
    "@tiptap/extension-task-item": "3.26.0",
    "@tiptap/extension-task-list": "3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "emoji-picker-react": "^4.18.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.11.0",
    "mcp-handler": "^2.1.0",
    "mysql2": "^3.23.2",
    "next": "^16.3.0",
    "pg": "^8.18.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.5",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.0",
    "tiptap-markdown": "^0.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.8.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@visvine/config": "workspace:*",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.0",
    "knip": "^6.26.0",
    "prisma": "7.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
