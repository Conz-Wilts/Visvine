    "motion": "^13.4.4",
    "mysql2": "^3.23.2",
    "nanoid": "^6.0.1",
    "next": "^16.3.5",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.18.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-virtuoso": "^4.18.5",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
