{
  "name": "@visvine/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "lint:fix": "next lint --fix",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/*.test.ts",
    "prisma:generate": "pnpm dlx prisma@7.4.0 generate",
    "prisma:studio": "pnpm dlx prisma@7.4.0 studio",
    "db:push": "pnpm dlx prisma@7.4.0 db push && node scripts/apply-sql-functions.mjs",
    "db:fresh": "node ../../scripts/guard-local-db.mjs && pnpm dlx prisma@7.4.0 db push --force-reset --accept-data-loss && node scripts/apply-sql-functions.mjs && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "embed:backfill": "tsx scripts/embed-backfill.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@google-cloud/storage": "^7.19.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-text-style": "3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/static-renderer": "^3.26.0",
    "@types/d3-force": "^3.0.10",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dotenv": "^17.3.1",
    "emoji-picker-react": "^4.18.0",
    "jose": "^5.10.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.11.0",
    "next": "^15.5.9",
    "openai": "^6.13.0",
    "pg": "^8.18.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.5",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@faker-js/faker": "^10.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.64.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "@types/web-push": "^3.6.4",
    "@visvine/config": "workspace:*",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.15",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prisma": "7.4.0",
    "seedrandom": "^3.0.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
