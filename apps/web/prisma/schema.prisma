  viewMode    ChannelViewMode      @default(CHAT) @map("view_mode")
  dmKey       String?              @unique @map("dm_key")
  /// Set for CHANNEL conversations — channels are community-scoped and discoverable by community members.
  communityId String?              @map("community_id")
  /// Optional grouping of CHANNEL conversations into a community "space" section.
  spaceId     String?              @map("space_id")
  createdById String               @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  members     ConversationMember[]
  community   Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  space       ChannelSpace?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([type])
  @@index([updatedAt])
  @@index([communityId, type])
