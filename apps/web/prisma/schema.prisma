generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Space {
  id              String                 @id
  name            String
  description     String?
  location        String?
  tags            String[]               @default([])
  createdAt       DateTime               @default(now()) @map("created_at")
  imageUrl        String?                @map("image_url")
  nodeTypes       Json?                  @default("[{\"name\": \"Person\", \"color\": \"#2563eb\", \"shape\": \"rectangle\"}, {\"name\": \"Space\", \"color\": \"#78d870\", \"shape\": \"square\"}, {\"name\": \"Event\", \"color\": \"#ef4444\", \"shape\": \"rectangle\"}]") @map("node_types")
  aliases         Json?                  @default("[{\"name\": \"Owner\", \"color\": \"#b4881b\", \"owner\": true, \"system\": true, \"nodeType\": \"Person\"}]")
  linkTypes       Json?                  @default("[{\"name\": \"Related\", \"color\": \"#94a3b8\", \"directed\": false}, {\"name\": \"Knows\", \"color\": \"#2563eb\", \"directed\": false}, {\"name\": \"Works at\", \"color\": \"#9333ea\", \"directed\": true}, {\"name\": \"Founded\", \"color\": \"#16a34a\", \"directed\": true}, {\"name\": \"Invested in\", \"color\": \"#f59e0b\", \"directed\": true}, {\"name\": \"Member of\", \"color\": \"#0ea5e9\", \"directed\": true}, {\"name\": \"Partner\", \"color\": \"#ec4899\", \"directed\": false}, {\"name\": \"Mentors\", \"color\": \"#14b8a6\", \"directed\": true}, {\"name\": \"Attended\", \"color\": \"#ef4444\", \"directed\": true, \"system\": true}, {\"name\": \"Hosting\", \"color\": \"#ef4444\", \"directed\": true, \"system\": true}, {\"name\": \"Introduced\", \"color\": \"#06b6d4\", \"directed\": false, \"system\": true}, {\"name\": \"Mentioned\", \"color\": \"#8b5cf6\", \"directed\": false, \"system\": true}]") @map("link_types")
  country         String?
  designConfig    Json                   @default("{}") @map("design_config")
  featureConfig   Json                   @default("{}") @map("feature_config")
  // Set = a private, single-member "personal space" owned by this user (created on
  // first use to host their personal context notes). Null = a normal space.
  // Filtered out of Discover / other users' space lists.
  personalOwnerId String?                @map("personal_owner_id")
  // "public" = discoverable & self-joinable from Discover; "private" = hidden from
  // Discover / non-members' lists, joinable only via invite link or admin add.
  // Private by default: a space someone forgot to set visibility on must err
  // toward hidden, never toward discoverable (demo seeds opt into public).
  visibility      String                 @default("private")
  // Reusable, revocable invite token. Regenerating overwrites it, invalidating the
  // previously shared link. Null until first generated.
  inviteToken     String?                @unique @map("invite_token")
  // IANA zone the space's scheduled agents run in when an agent doesn't name
  // its own (lib/agents/config.ts). Null = UTC.
  timezone        String?
  // Space-wide agent settings that are admin-only by nature and never note
  // fields: { customEndpoint?: { baseURL } } (lib/agents/providers.ts).
  agentConfig     Json                   @default("{}") @map("agent_config")
  links           Link[]
  nodes           Node[]
  members         SpaceMember[]
  notes           ContextNote[]
  noteFolders     ContextFolder[]
  contextState    ContextState[]
  secrets         ConnectorSecret[]
  noteEmbeddings  ContextNoteEmbedding[]
  contextSources  ContextSource[]
  userAliases     UserAlias[]
  contextGrants   ContextGrant[]
  accessRequests  ContextAccessRequest[]
  publicationsOut ContextPublication[]   @relation("PublicationSource")
  publicationsIn  ContextPublication[]   @relation("PublicationTarget")
  agentStates     AgentState[]
  agentRuns       AgentRun[]

  channels        Conversation[]
  channelSections ChannelSection[]

  appToolBuilds   AppToolBuild[]
  appToolInstalls AppToolInstall[]

  @@index([personalOwnerId])
  @@map("spaces")
}

/// A markdown note in a space's notes/knowledge surface. Notes live in a
/// "context" identified by (spaceId, ownerKey): ownerKey "shared" = the
/// space-wide context every member sees; any other value is a userId = that
/// user's personal context scoped to this space. `path` is the context-relative
/// POSIX path ("portfolio/canva.md") and doubles as the link-resolution identity,
/// so the pure index/context/backlink pipeline (lib/notes/shared) treats a row exactly
/// like a file on disk. `content` (full markdown incl. YAML frontmatter) is the
/// source of truth. Soft-deleted notes (deletedAt set) are the trash.
model ContextNote {
  id          String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId     String                @map("space_id")
  ownerKey    String                @map("owner_key") // 'shared' = space context; else a userId = personal context
  path        String // context-relative POSIX path, e.g. "portfolio/canva.md"
  content     String // full markdown incl. frontmatter (source of truth)
  starred     Boolean               @default(false) // synced from frontmatter `starred:` on every write
  createdBy   String                @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at") // soft-delete = trash; null = live
  deletedPath String?               @map("deleted_path") // original path while trashed
  space       Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  revisions   ContextNoteRevision[]

  @@unique([spaceId, ownerKey, path], name: "note_identity")
  @@index([spaceId, ownerKey, deletedAt])
  @@map("context_notes")
}

/// Append-only revision snapshots for a ContextNote (newest by `at`): a baseline
/// is seeded on first edit and every save records a full snapshot,
/// capped/coalesced in lib/notes/store.ts.
model ContextNoteRevision {
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  noteId      String      @map("note_id")
  at          DateTime    @default(now())
  editor      String // display name of who saved it (from the session)
  editorEmail String?     @map("editor_email")
  origin      String      @default("edit") // edit | ai-refactor | ai-enrich | agent | maintenance | restore | baseline
  model       String? // LLM model (or agent client) name when AI-originated
  content     String // full snapshot (frontmatter + body) at this save
  note        ContextNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, at])
  @@map("context_note_revisions")
}

/// Explicitly-created folders for a context. Notes already imply their ancestor
/// folders, but this table lets empty folders exist and be renamed; the tree
/// builder grafts these in alongside note-derived folders. `restricted` and
/// `locked` are the shared context's folder-boundary flags (lib/notes/shared/authz.ts):
/// a restricted folder cuts ContextGrant inheritance at its boundary (only grants on
/// or inside it reach its notes); a locked folder is frozen for AI maintenance.
/// Flagging a folder that only exists implicitly upserts its row first.
model ContextFolder {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String   @map("space_id")
  ownerKey   String   @map("owner_key")
  path       String
  restricted Boolean  @default(false)
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path], name: "folder_identity")
  @@index([spaceId, ownerKey])
  @@map("context_folders")
}

/// Control-plane sidecar for a context. One row per named file per context: the
/// folder registry ("folders.json"), read-audit log ("audit.jsonl"), join
/// requests ("join-requests.jsonl"), enrichment ledger ("enrichment-state.json").
/// Content is text (JSON or JSONL); the domain layer (lib/notes/sidecar.ts)
/// owns parsing. Keyed like notes so personal contexts can also carry state.
model ContextState {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  ownerKey  String   @map("owner_key") // 'shared' or a userId, same as ContextNote
  name      String // e.g. "folders.json", "audit.jsonl"
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, name], name: "context_state_identity")
  @@map("context_state")
}

/// A named secret a connector note can reference as {{secret:NAME}}. The value
/// is AES-256-GCM encrypted with the server-wide SECRETS_KEY (lib/crypto/secrets.ts)
/// and only ever decrypted server-side while executing a connector call — the
/// admin API lists names but never returns plaintext.
model ConnectorSecret {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String   @map("space_id")
  name       String // ^[A-Z][A-Z0-9_]{0,63}$
  ciphertext String // aes256gcm$iv$tag$cipher
  createdBy  String?  @map("created_by") // admin email, for the audit trail
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, name], name: "secret_identity")
  @@map("connector_secrets")
}

/// The scheduler's index of one Space agent (lib/agents). The NOTES stay
/// authoritative — `agents/<name>.md` is the brief, `agents/live/<name>.md`
/// holds `active` and the schedule — and this row is derived from them on
/// every write (`scheduleHash` lets a tick notice a note that changed under
/// it and re-derive). It exists so "who is due" is one indexed query instead
/// of parsing every live agent note every five minutes, and so overlap
/// suppression is an atomic compare-and-swap on `status` that survives ten
/// Cloud Run instances. `budgetMonthlyCents` is the one agent fact that is
/// deliberately NOT in a note: money is admin-read, notes are member-read.
model AgentState {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId             String    @map("space_id")
  name                String // agent name = basename of agents/<name>.md
  runAsUserId         String?   @map("run_as_user_id") // the brief's author; the principal a run acts as
  active              Boolean   @default(false)
  status              String    @default("idle") // idle | running
  nextRunAt           DateTime? @map("next_run_at")
  lastRunAt           DateTime? @map("last_run_at")
  runningSince        DateTime? @map("running_since")
  currentRunId        String?   @map("current_run_id") // the AgentRun holding the `running` claim; release is a CAS on it
  scheduleHash        String?   @map("schedule_hash")
  budgetMonthlyCents  Int?      @map("budget_monthly_cents") // null = uncapped
  deactivatedReason   String?   @map("deactivated_reason") // brief_changed | key_rejected | repeated_failure | author_gone | renamed | deleted | admin
  deactivatedDetail   String?   @map("deactivated_detail") // e.g. who edited the brief
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  space               Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  runs                AgentRun[]

  @@unique([spaceId, name], name: "agent_identity")
  @@index([active, nextRunAt])
  @@map("agent_state")
}

/// One execution of a Space agent — the run record and its transcript. Written
/// first-hand by the executor (lib/agents/runner.ts): usage, cost, terminal
/// reason and the `AgentEvent` trace (tool results clipped, secrets already
/// redacted by the isolate). Monthly spend is SUM(costMicros) by startedAt.
model AgentRun {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  stateId          String    @map("state_id")
  spaceId          String    @map("space_id")
  name             String
  trigger          String // scheduled | manual
  status           String    @default("running") // running | succeeded | failed
  startedAt        DateTime  @default(now()) @map("started_at")
  endedAt          DateTime? @map("ended_at")
  startedBy        String?   @map("started_by") // userId for manual runs
  model            String?
  promptTokens     Int       @default(0) @map("prompt_tokens")
  completionTokens Int       @default(0) @map("completion_tokens")
  costMicros       BigInt?   @map("cost_micros") // USD micro-dollars; null = pricing unknown
  turns            Int       @default(0)
  terminalReason   String?   @map("terminal_reason") // finished | max_turns | budget | timeout | crashed | error | auth | quota | upstream | config | author_gone
  summary          String? // the model's final answer, capped
  errorMessage     String?   @map("error_message") // redacted
  events           Json      @default("[]") // AgentEvent[] trace
  state            AgentState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  space            Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([stateId, startedAt(sort: Desc)])
  @@index([spaceId, startedAt])
  @@map("agent_runs")
}

/// Single-row liveness record for the agent scheduler tick. If it stops
/// moving, every agent in every space goes quiet with nothing failing — this
/// is how the panel tells a Space that the watcher itself is down.
model AgentHeartbeat {
  id         Int      @id @default(1)
  lastTickAt DateTime @map("last_tick_at")

  @@map("agent_heartbeat")
}

/// A space's own compiled snapshot of one `tools/<name>/` Tool note (lib/tools).
/// Written by the store hook on every save of `index.md`/`ui.md`/`data.md`:
/// esbuild compiles the sources, `errors`/`warnings` are the `CompileDiagnostic[]`
/// shown back to the author, `config` is the parsed+validated frontmatter (or
/// null when `configError` explains why parsing failed). This is the AUTHOR'S
/// working copy — publishing snapshots one into the immutable AppToolVersion
/// registry, so nothing here is ever read by an install.
model AppToolBuild {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId     String   @map("space_id")
  name        String
  sourceHash  String   @map("source_hash") // hash of index.md+ui.md+data.md at compile time
  ok          Boolean
  uiBundle    String?  @map("ui_bundle") // compiled ESM, null when compilation failed
  dataBundle  String?  @map("data_bundle")
  errors      Json     @default("[]") // CompileDiagnostic[]
  warnings    Json     @default("[]") // CompileDiagnostic[]
  sizeBytes   Int      @map("size_bytes")
  config      Json? // parsed ToolConfig, or null when configError is set
  configError String?  @map("config_error")
  /// The author's own rail glyph from icon.md — ALREADY SANITIZED by
  /// lib/tools/iconSvg.ts. Null when the Tool uses a built-in icon. Stored
  /// sanitized on purpose: this is what the rail renders, and nothing
  /// downstream re-parses author markup.
  iconSvg     String?  @map("icon_svg")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, name], name: "app_tool_build_identity")
  @@map("app_tool_builds")
}

/// The global, IMMUTABLE marketplace registry: one row per published Tool
/// version, keyed `<sourceSpaceId>/<name>` + `version`. Publishing snapshots the
/// author's current AppToolBuild here for super-admin review (`status`); once
/// approved a version never changes — an upgrade is a new row, never an update
/// to this one. `sourceSpaceId` is a plain string, NOT a foreign key: a
/// published version must survive its authoring space being deleted, since
/// other spaces may already have it installed.
model AppToolVersion {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  key           String // `<sourceSpaceId>/<name>`
  name          String
  version       Int
  title         String
  description   String?
  authorUserId  String?   @map("author_user_id")
  sourceSpaceId String    @map("source_space_id") // no FK — must outlive the source space
  config        Json // validated ToolConfig at publish time
  perimeter     Json // declared reach: note globs / types / connectors / agents
  indexSource   String    @map("index_source") // index.md body (docs) at publish time
  uiSource      String    @map("ui_source") // ui.tsx source at publish time
  dataSource    String    @map("data_source") // data.js source at publish time
  /// The Tool's own rail glyph, sanitized at build time (lib/tools/iconSvg.ts)
  /// and snapshotted here so an install carries it. Null = uses a built-in.
  iconSvg       String?   @map("icon_svg")
  uiBundle      String    @map("ui_bundle") // compiled ESM
  dataBundle    String    @map("data_bundle") // compiled ESM
  sizeBytes     Int       @map("size_bytes")
  status        String    @default("pending") // pending | approved | rejected | withdrawn
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String?   @map("review_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  author        User?     @relation("AppToolVersionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  installs      AppToolInstall[]

  @@unique([key, version], name: "app_tool_version_identity")
  @@index([status, submittedAt])
  @@map("app_tool_versions")
}

/// A Tool installed into a space, pinned to one AppToolVersion. `key` mirrors
/// the pinned version's key so lookups don't need a join; `requirements` is the
/// missing-connectors/types/agents snapshot from the last check (an unmet
/// requirement degrades the Tool, it never blocks install); `typeClaims` is the
/// admin-confirmed set of context types this install owns a page/tab for.
/// `pendingVersionId` names an approved newer AppToolVersion awaiting an
/// admin-triggered upgrade — deliberately NOT a foreign key, so an admin can
/// still see "an upgrade is available" even if that row were ever withdrawn.
model AppToolInstall {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId          String   @map("space_id")
  versionId        String   @map("version_id")
  key              String
  slug             String // rail slug: tool:<slug>
  enabled          Boolean  @default(true)
  installedBy      String   @map("installed_by")
  requirements     Json     @default("{}") // { connectors: string[]; types: string[]; agents: string[] } — MISSING items at last check
  typeClaims       Json     @default("{}") @map("type_claims") // { [typeName]: 'page' | 'tab' }
  pendingVersionId String?  @map("pending_version_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  space            Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  version          AppToolVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  state            AppToolState[]

  @@unique([spaceId, key], name: "app_tool_install_identity")
  @@unique([spaceId, slug], name: "app_tool_install_slug")
  @@map("app_tool_installs")
}

/// Per-install key/value state written through the Tool bridge's `visvine.state`
/// capability (a Tool's iframe runs sandboxed without `allow-same-origin`, so it
/// has no localStorage — this is its persistence instead).
model AppToolState {
  id        String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  installId String         @map("install_id")
  key       String
  value     Json
  updatedAt DateTime       @updatedAt @map("updated_at")
  install   AppToolInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@unique([installId, key], name: "app_tool_state_identity")
  @@map("app_tool_state")
}

/// Which of its space's PERSON ALIASES a member holds. The aliases themselves
/// live in `Space.aliases` (lib/types/context.ts#SpaceAlias) — the same
/// vocabulary that colours a person's chip in the directory IS the permission
/// model, so this points into a JSON array rather than at another table.
///
/// It points at `SpaceAlias.id`, NOT the name. Holding an alias is what makes
/// someone an admin (lib/auth.ts#isAdmin), and a name is editable: keying on it
/// meant every rename had to rewrite this table, `ContextGrant.subjectId` and
/// `Node.alias` in step, and any drift — a casing mismatch, a half-applied
/// cascade — silently revoked people's access. An id is not editable, so a
/// rename is now one write to `Space.aliases` and nothing here moves.
///
/// A person holds any number of them, with no restrictions on which. An alias
/// marked `owner` there means its holders manage the space; the built-in
/// Owner alias (id `owner`) always does. Rows are deleted when the user leaves
/// the space (lib/notes/access.ts#removeMemberAccess) — grants stop matching
/// instantly.
model UserAlias {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  userId    String   @map("user_id")
  aliasId   String   @map("alias_id")
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId, aliasId], name: "user_alias_identity")
  @@index([userId])
  @@index([spaceId, aliasId])
  @@map("user_aliases")
}

/// One access grant on a space's SHARED context: *subject* gets *level* on
/// *resource*. The whole permission model (lib/notes/shared/authz.ts) reduces to
/// these rows plus the `restricted` folder flags: access flows down the folder
/// tree from `resourcePath` ('' = context root, a folder path at any depth, or a
/// single note path), a restricted folder cuts inheritance at its boundary, and
/// a member's effective level on a note is the MAX across every grant that
/// reaches it (space-wide + their aliases' + their own). Grants only ever add.
model ContextGrant {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId      String   @map("space_id")
  subjectType  String   @map("subject_type") // 'space' | 'alias' | 'user'
  // '' for the space itself | SpaceAlias.id | userId. Alias grants hold the
  // alias's stable id, never its name — see the note on UserAlias.
  subjectId    String   @default("") @map("subject_id")
  resourcePath String   @default("") @map("resource_path") // '' = context root
  level        Int // 10 view · 20 comment · 30 edit · 40 full
  grantedBy    String   @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at")
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, subjectType, subjectId, resourcePath], name: "grant_identity")
  @@index([spaceId, subjectType, subjectId])
  @@map("context_grants")
}

/// A member's request for access to part of a space's SHARED context, filed
/// from whatever surface denied them (`resourcePath` '' = the context root gate, a
/// folder, or a single note path — the path is recorded even when it doesn't
/// exist, so the denial copy never has to admit whether it does). Whoever
/// MANAGES that path resolves it: approval writes a ContextGrant at exactly the
/// requested path (lib/notes/accessRequests.ts). Resolved rows are kept as the
/// audit trail behind Console → People → Waiting.
model ContextAccessRequest {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId      String    @map("space_id")
  userId       String    @map("user_id")
  resourcePath String    @default("") @map("resource_path") // '' = context root
  level        Int       @default(10) // the level asked for (10 view · 20 comment · 30 edit · 40 full)
  message      String?
  status       String    @default("pending") // 'pending' | 'approved' | 'denied'
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedBy   String?   @map("resolved_by")
  resolvedAt   DateTime? @map("resolved_at")
  grantedLevel Int?      @map("granted_level") // what the resolver actually gave
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
  @@index([userId])
  @@map("context_access_requests")
}

/// A live publish link between two contexts: the source note stays owned by its
/// context, and a replica lives as a REAL note row in the target space's
/// shared context, overwritten on every source save (origin 'publish'). No read
/// path ever crosses a space boundary — the only cross-tenant motion is the
/// replicating write (lib/notes/publications.ts). `active: false` (unlink, or a
/// deleted source/replica) leaves the replica behind as a plain editable copy.
model ContextPublication {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceSpaceId String    @map("source_space_id")
  sourcePath    String    @map("source_path")
  targetSpaceId String    @map("target_space_id")
  targetPath    String    @map("target_path")
  active        Boolean   @default(true)
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  sourceSpace   Space     @relation("PublicationSource", fields: [sourceSpaceId], references: [id], onDelete: Cascade)
  targetSpace   Space     @relation("PublicationTarget", fields: [targetSpaceId], references: [id], onDelete: Cascade)

  @@unique([sourceSpaceId, sourcePath, targetSpaceId], name: "publication_identity")
  @@index([sourceSpaceId, sourcePath])
  @@index([targetSpaceId, targetPath])
  @@map("context_publications")
}

/// Cached whole-note embedding for the retrieval vector stage (pgvector).
/// Keyed by the note's context + path; `mtime` is the note's updatedAt epoch-ms at
/// embed time, so a stale row (mtime mismatch) is lazily re-embedded on the next
/// search. `embedding` is written/read via raw SQL (Prisma can't type vector).
model ContextNoteEmbedding {
  id        String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String                      @map("space_id")
  ownerKey  String                      @map("owner_key")
  path      String
  model     String // embedding model name; rows from an old model are ignored
  mtime     BigInt // note updatedAt (epoch ms) when embedded
  embedding Unsupported("vector(768)")?
  updatedAt DateTime                    @updatedAt @map("updated_at")
  space     Space                       @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path], name: "embedding_identity")
  @@map("context_note_embeddings")
}

/// A non-note source (uploaded file/table) attached to a context. Lives ONLY in
/// the Context — never a Node, never in the workspace/directory. Keyed
/// (spaceId, ownerKey, path) exactly like ContextNote so the folder gate
/// and visibility lens apply to sources unchanged; `path` must NOT end in .md
/// (the note namespace stays disjoint). The original file lives in GCS; the
/// extracted text lives chunked in ContextSourceChunk.
model ContextSource {
  id         String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String               @map("space_id")
  ownerKey   String               @map("owner_key") // 'shared' or a userId, same as ContextNote
  path       String // context-relative POSIX path incl. filename, e.g. "deals/pricing.csv"
  name       String // display filename
  kind       String // 'csv' | 'markdown' | 'text' (extension point: 'pdf' | 'xlsx')
  mimeType   String               @map("mime_type")
  sizeBytes  Int                  @map("size_bytes")
  gcsPath    String               @map("gcs_path") // object in GCS_RESOURCES_BUCKET
  status     String               @default("pending") // pending | ready | failed
  error      String? // failure detail when status = failed
  truncated  Boolean              @default(false) // extraction hit the text/chunk caps
  textChars  Int?                 @map("text_chars") // extracted-text length
  chunkCount Int                  @default(0) @map("chunk_count")
  createdBy  String               @map("created_by")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  space      Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  chunks     ContextSourceChunk[]

  @@unique([spaceId, ownerKey, path], name: "source_identity")
  @@index([spaceId, ownerKey, status])
  @@map("context_sources")
}

/// One embedded chunk of a ContextSource. spaceId/ownerKey/path are
/// denormalized from the source so the pgvector ranking query filters without a
/// join (as in context_note_embeddings). `text` is the source of truth for
/// snippets and paged source reads; `embedding` is written/read via raw SQL.
model ContextSourceChunk {
  id        String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceId  String                      @map("source_id")
  spaceId   String                      @map("space_id")
  ownerKey  String                      @map("owner_key")
  path      String
  seq       Int // 0-based order within the source
  text      String
  model     String? // embedding model; null = stored without a vector
  embedding Unsupported("vector(768)")?
  source    ContextSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, seq])
  @@index([spaceId, ownerKey, model])
  @@map("context_source_chunks")
}

model Node {
  id             String          @id
  type           String
  name           String
  subtitle       String?
  location       String?
  url            String?
  tags           String[]        @default([])
  imageUrl       String?         @map("image_url")
  metadata       Json            @default("{}")
  spaceId        String?         @map("space_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  // The alias chip this card wears, as a NAME. Overloaded: for an event it is
  // the public /e/<slug> slug, for a connector the executor kind — neither of
  // which is vocabulary. Read through lib/types/context.ts#findAlias, which only
  // treats it as an alias when the space actually defines one by that name for
  // this node's type. Display and search only; `aliasId` is the truth.
  alias          String?
  // The space alias this card wears (`SpaceAlias.id`). Survives renames, which
  // the name copy above does not — see the note on UserAlias.
  aliasId        String?         @map("alias_id")
  // Canonical cross-space identity this node represents (people/orgs). Nullable:
  // legacy rows and non-person/org types may have none. Set by lib/identity/resolve.
  identityId     String?         @map("identity_id")
  identity       Identity?       @relation(fields: [identityId], references: [id], onDelete: SetNull)
  attendees      EventAttendee[] @relation("EventNode")
  attendeePerson EventAttendee[] @relation("PersonNode")
  linksAsSource  Link[]          @relation("SourceNode")
  linksAsTarget  Link[]          @relation("TargetNode")
  space          Space?          @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([type])
  @@index([spaceId, type])
  @@index([identityId])
  @@index([spaceId, aliasId])
  @@map("nodes")
}

model Link {
  id           Int      @id @default(autoincrement())
  sourceId     String   @map("source_id")
  targetId     String   @map("target_id")
  relationship String
  since        String?
  metadata     Json     @default("{}")
  spaceId      String?  @map("space_id")
  createdAt    DateTime @default(now()) @map("created_at")
  // Provenance + dedup. `pairKey` is the
  // normalized "minId|maxId" of the two endpoints so A->B and B->A dedup as one
  // edge; always computed by lib/context/links.ts upsertLink, never raw-written blank.
  origin       String   @default("manual") @map("origin") // manual | event_attendance | event_hosting | intro | context | structure | import
  originRef    String?  @map("origin_ref") // EventAttendee.id / IntroRequest.id / event node id / context-note path / contained node id — for symmetric auto-undo
  createdBy    String?  @map("created_by") // userId for manual links; null for system/auto
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  pairKey      String   @map("pair_key")
  space        Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  source       Node     @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Node     @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([spaceId, pairKey, relationship], name: "link_identity") // dedup; origin deliberately NOT in the key
  @@index([sourceId])
  @@index([targetId])
  @@index([spaceId])
  @@index([pairKey])
  @@map("links")
}

model EventAttendee {
  id           String    @id
  eventId      String    @map("event_id")
  personId     String?   @map("person_id")
  name         String? // typed guest name (loginless RSVP; no Person node required)
  email        String?
  linkedinUrl  String?   @map("linkedin_url")
  companyName  String?   @map("company_name")
  roleTitle    String?   @map("role_title")
  answers      Json      @default("{}")
  // Operational lifecycle: going | waitlisted | pending | checked_in | no_show | cancelled | invited.
  // Legacy rows may still hold 'registered' (normalized to 'going' on read — see eventUtils.normalizeStatus).
  status       String    @default("going")
  // Guest's intent, separate from the operational status: going | maybe | declined.
  response     String?
  plusOnes     Int       @default(0) @map("plus_ones")
  plusOneNames String[]  @default([]) @map("plus_one_names")
  invitedBy    String?   @map("invited_by") // userId/personId who invited/added them
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  checkinAt    DateTime? @map("checkin_at")
  event        Node      @relation("EventNode", fields: [eventId], references: [id], onDelete: Cascade)
  person       Node?     @relation("PersonNode", fields: [personId], references: [id])

  @@unique([eventId, email]) // dedupe RSVPs by email (NULL emails remain distinct in Postgres)
  @@index([eventId])
  @@index([eventId, status])
  @@index([personId])
  @@index([email])
  @@map("event_attendees")
}

model User {
  id            String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  claimNonce    String?       @unique @map("claim_nonce")
  googleId      String?       @unique @map("google_id")
  passwordHash  String?       @map("password_hash")
  isActive      Boolean       @default(true) @map("is_active")
  oauthProvider String?       @map("oauth_provider")
  publicMeta    Json          @default("{}") @map("public_meta")
  person        Person?
  membersAdded  SpaceMember[] @relation("AddedByRelation")
  memberships   SpaceMember[] @relation("MemberOf")

  // --- messaging ---
  conversationMemberships ConversationMember[]
  conversationsCreated    Conversation[]       @relation("ConversationCreator")
  messagesSent            Message[]            @relation("MessageSender")
  messageReactions        MessageReaction[]    @relation("ReactionAuthor")
  messageStars            MessageStar[]        @relation("StarAuthor")

  appToolVersionsAuthored AppToolVersion[]     @relation("AppToolVersionAuthor")

  @@map("users")
}

/// A person's membership of a space. Deliberately carries no role — what
/// they can do comes entirely from the Aliases they hold.
model SpaceMember {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String   @map("user_id")
  spaceId     String   @map("space_id")
  // "active" = full member; "pending" = requested to join via invite link, awaiting
  // admin approval in the space console.
  status      String   @default("active")
  joinedAt    DateTime @default(now()) @map("joined_at")
  addedBy     String?  @map("added_by")
  privateMeta Json     @default("{}") @map("private_meta")
  addedByUser User?    @relation("AddedByRelation", fields: [addedBy], references: [id])
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user        User     @relation("MemberOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([userId])
  @@index([spaceId])
  @@map("space_members")
}

model Person {
  id          String   @id
  userId      String?  @unique @map("user_id")
  name        String
  subtitle    String?
  bio         String?
  location    String?
  website     String?  @map("website")
  linkedinUrl String?  @map("linkedin_url")
  twitterUrl  String?  @map("twitter_url")
  phone       String?
  pronouns    String?
  imageUrl    String?  @map("image_url")
  tags        String[] @default([])
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User?    @relation(fields: [userId], references: [id])

  @@map("people")
}

/// Canonical, cross-space identity for a real person or organization.
/// Each space keeps its own private `Node` row; all nodes that represent the
/// same real person/org point to ONE Identity (Node.identityId). Communities never
/// share their per-node data — only identity-level facts live here (canonical name,
/// photo, strong identifiers). Resolution (lib/identity/resolve.ts) decides whether
/// a new node attaches to an existing identity or mints a new one. `userId` links the
/// identity to a registered User when claimed/verified (email/linkedin become
/// authoritative); kept as a plain unique scalar to avoid a relation on the large
/// User model. Strong identifiers are stored normalized and treated as effectively
/// unique per kind by the resolver/backfill (no DB partial-unique with db push).
model Identity {
  kind           String // 'person' | 'organization'
  canonicalName  String   @map("canonical_name")
  nameKey        String   @map("name_key") // normalized name, used for blocking
  imageUrl       String?  @map("image_url")
  email          String? // normalized lowercase (person)
  linkedinHandle String?  @map("linkedin_handle") // normalized "linkedin.com/in/x" (person)
  websiteDomain  String?  @map("website_domain") // normalized bare domain (org)
  metadata       Json     @default("{}") // survivorship signals: { company, location, ... }
  verified       Boolean  @default(false)
  userId         String?  @unique @map("user_id") // set when claimed by a registered User
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  nodes          Node[]

  @@index([kind, email])
  @@index([kind, linkedinHandle])
  @@index([kind, websiteDomain])
  @@index([kind, nameKey])
  @@map("identities")
}

/// Append-only audit trail of identity-resolution decisions, for transparency and
/// reversibility. Also records anti-matches: a `rejected` (or `split`) row for a
/// (nodeId, identityId) pair tells the resolver "these are NOT the same" so it never
/// re-suggests or re-auto-merges them. `actorUserId` is null for system decisions.
model IdentityResolution {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  nodeId      String   @map("node_id")
  identityId  String?  @map("identity_id") // candidate or chosen identity
  decision    String // auto_strong | auto_name_company | suggested | confirmed | rejected | split | merged
  confidence  Float    @default(0)
  reason      String // human-readable, e.g. "email match" | "name+company"
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([nodeId])
  @@index([identityId])
  @@index([decision])
  @@map("identity_resolutions")
}

model Resource {
  id         String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String            @map("space_id")
  name       String
  fileType   String            @map("file_type")
  fileUrl    String            @map("file_url")
  fileSize   Int?              @map("file_size")
  uploadedBy String            @map("uploaded_by")
  metadata   Json              @default("{}")
  createdAt  DateTime          @default(now()) @map("created_at")
  changes    ResourceChange[]
  comments   ResourceComment[]

  @@index([spaceId])
  @@map("resources")
}

model ResourceComment {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId String   @map("resource_id")
  cellRef    String?  @map("cell_ref")
  author     String
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([resourceId, cellRef])
  @@map("resource_comments")
}

model ResourceChange {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId    String    @map("resource_id")
  cellRef       String    @map("cell_ref")
  originalValue String?   @map("original_value")
  proposedValue String    @map("proposed_value")
  reason        String?
  proposedBy    String    @map("proposed_by")
  status        String    @default("pending")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  resource      Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([resourceId, status])
  @@map("resource_changes")
}

// ─── MCP OAuth 2.1 authorization server (self-hosted) ───

/// A Dynamically-Registered (RFC 7591) MCP/OAuth client. Public clients (PKCE),
/// no client secret. `redirectUris` is the allowlist enforced at /authorize.
model OAuthClient {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  clientId     String   @unique @map("client_id")
  clientName   String?  @map("client_name")
  redirectUris String[] @default([]) @map("redirect_uris")
  scope        String? // space-delimited scopes the client may request
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("oauth_clients")
}

/// Short-lived, single-use authorization code (PKCE). Bound to the user that
/// approved consent, the requested scope, and the client's redirect_uri.
model OAuthAuthCode {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                String    @unique
  clientId            String    @map("client_id")
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri")
  scope               String
  /// Which MCP server the token is for (RFC 8707): "context" | "creator".
  resource            String    @default("context")
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_auth_codes")
}

/// Rotating refresh token (stored as a SHA-256 hash, never plaintext).
model OAuthRefreshToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tokenHash String    @unique @map("token_hash")
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  scope     String
  /// Which MCP server refreshed tokens are for (RFC 8707): "context" | "creator".
  resource  String    @default("context")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("oauth_refresh_tokens")
}

// ============================================================
// Restored features: Channels/Messages, Feed
// ============================================================

model Conversation {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  type        ConversationType     @default(DM)
  name        String?
  description String?
  avatarUrl   String?              @map("avatar_url")
  /// Name of an owned icon (assets/icons) for CHANNEL conversations. Null =
  /// the default hashtag. Held emoji until the 2026-08 icon rename.
  icon        String?
  /// How a CHANNEL renders: classic chat thread or social-feed post cards.
  viewMode    ChannelViewMode      @default(CHAT) @map("view_mode")
  /// Sorted "userA:userB" pair for a DM, so the same two people can only ever
  /// have one. Written by the seed; no runtime path creates a DM yet.
  dmKey       String?              @unique @map("dm_key")
  /// Set for CHANNEL conversations — channels are space-scoped and discoverable by space members.
  spaceId     String?              @map("space_id")
  /// Optional grouping of CHANNEL conversations into a named section.
  sectionId   String?              @map("section_id")
  createdById String               @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  members     ConversationMember[]
  space       Space?               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  section     ChannelSection?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([type])
  @@index([updatedAt])
  @@index([spaceId, type])
  @@index([sectionId])
  @@map("conversations")
}

/// A named section grouping a space's channels in the channel rail. Called
/// a "space" until the 2026-08 vocabulary rename freed that word for the tenant
/// itself. Deleting a section unfiles its channels (sectionId → null).
model ChannelSection {
  id        String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String         @map("space_id")
  name      String
  /// Name of an owned icon (assets/icons), or null for none. Held emoji until
  /// the 2026-08 icon rename — see docs/icons.md.
  icon      String?
  position  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  space     Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  channels  Conversation[]

  @@index([spaceId, position])
  @@map("channel_sections")
}

model ConversationMember {
  id             String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String                 @map("conversation_id")
  userId         String                 @map("user_id")
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now()) @map("joined_at")
  lastReadAt     DateTime?              @map("last_read_at")
  mutedUntil     DateTime?              @map("muted_until")
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([conversationId, lastReadAt])
  @@map("conversation_members")
}

model Message {
  id             String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String               @map("conversation_id")
  senderId       String               @map("sender_id")
  text           String
  attachmentUrl  String?              @map("attachment_url")
  editedAt       DateTime?            @map("edited_at")
  deletedAt      DateTime?            @map("deleted_at")
  replyToId      String?              @map("reply_to_id")
  pinnedAt       DateTime?            @map("pinned_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]            @relation("MessageReplies")
  images         MessageImage[]
  mentions       MessageMention[]
  reactions      MessageReaction[]
  linkPreviews   MessageLinkPreview[]
  stars          MessageStar[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([conversationId, pinnedAt])
  @@map("messages")
}

model MessageImage {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  imageUrl  String   @map("image_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_images")
}

model MessageMention {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId       String   @map("message_id")
  mentionedUserId String?  @map("mentioned_user_id")
  mentionedNodeId String?  @map("mentioned_node_id")
  mentionType     String   @default("user") @map("mention_type")
  createdAt       DateTime @default(now()) @map("created_at")
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([mentionedUserId])
  @@index([mentionedNodeId])
  @@map("message_mentions")
}

model MessageReaction {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

/// Per-user "saved message" bookmark (Slack-style starring).
model MessageStar {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("StarAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("message_stars")
}

model LinkPreview {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  url         String               @unique
  title       String?
  description String?
  imageUrl    String?              @map("image_url")
  siteName    String?              @map("site_name")
  fetchedAt   DateTime             @default(now()) @map("fetched_at")
  messages    MessageLinkPreview[]

  @@map("link_previews")
}

model MessageLinkPreview {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId     String      @map("message_id")
  linkPreviewId String      @map("link_preview_id")
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  linkPreview   LinkPreview @relation(fields: [linkPreviewId], references: [id])

  @@index([messageId])
  @@map("message_link_previews")
}

enum ConversationType {
  DM
  GROUP
  CHANNEL
}

enum ConversationMemberRole {
  MEMBER
  ADMIN
}

/// How a CHANNEL conversation renders: classic chat thread or social-feed post cards.
enum ChannelViewMode {
  CHAT
  FEED
}
