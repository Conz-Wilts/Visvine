// ─── MCP OAuth 2.1 authorization server (self-hosted) ───

/// A Dynamically-Registered (RFC 7591) MCP/OAuth client. Public clients (PKCE),
/// no client secret. `redirectUris` is the allowlist enforced at /authorize.
model OAuthClient {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  clientId     String   @unique @map("client_id")
  clientName   String?  @map("client_name")
  redirectUris String[] @default([]) @map("redirect_uris")
  scope        String? // space-delimited scopes the client may request
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("oauth_clients")
}

/// Short-lived, single-use authorization code (PKCE). Bound to the user that
/// approved consent, the requested scope, and the client's redirect_uri.
model OAuthAuthCode {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                String    @unique
  clientId            String    @map("client_id")
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri")
  scope               String
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_auth_codes")
}

// ============================================================
// Restored features: Channels/Messages, Feed
// ============================================================

model Conversation {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  type        ConversationType     @default(DM)
  name        String?
  description String?
  avatarUrl   String?              @map("avatar_url")
  /// Name of an owned icon (assets/icons) for CHANNEL conversations. Null =
  /// the default hashtag. Held emoji until the 2026-08 icon rename.
  icon        String?
  /// How a CHANNEL renders: classic chat thread or social-feed post cards.
  viewMode    ChannelViewMode      @default(CHAT) @map("view_mode")
  /// A PRIVATE channel is listed to, and joined by, its members only; a member
  /// adds a member. Its note and its files' notes are granted to the channel.
  visibility  ChannelVisibility    @default(PUBLIC)
  /// Set for CHANNEL conversations — channels are space-scoped and discoverable by space members.
  spaceId     String?              @map("space_id")
  /// Optional grouping of CHANNEL conversations into a named section.
  sectionId   String?              @map("section_id")
  createdById String               @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  members     ConversationMember[]
  space       Space?               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  section     ChannelSection?      @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    Message[]
  resources   Resource[]
  shares      ResourceShare[]

  @@index([type])
  @@index([updatedAt])
  @@index([spaceId, type])
  @@index([sectionId])
  @@map("conversations")
}

/// A named section grouping a space's channels in the channel rail. Called
/// a "space" until the 2026-08 vocabulary rename freed that word for the tenant
/// itself. Deleting a section unfiles its channels (sectionId → null).
model ChannelSection {
  id        String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String         @map("space_id")
  name      String
  /// Name of an owned icon (assets/icons), or null for none. Held emoji until
  /// the 2026-08 icon rename — see docs/icons.md.
  icon      String?
  position  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  space     Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  channels  Conversation[]

  @@index([spaceId, position])
  @@map("channel_sections")
}

model ConversationMember {
  id             String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String                 @map("conversation_id")
  userId         String                 @map("user_id")
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now()) @map("joined_at")
  lastReadAt     DateTime?              @map("last_read_at")
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId, lastReadAt])
  @@map("conversation_members")
}

model Message {
  id             String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String               @map("conversation_id")
  senderId       String               @map("sender_id")
  text           String
  attachmentUrl  String?              @map("attachment_url")
  editedAt       DateTime?            @map("edited_at")
  deletedAt      DateTime?            @map("deleted_at")
  replyToId      String?              @map("reply_to_id")
  pinnedAt       DateTime?            @map("pinned_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]            @relation("MessageReplies")
  images         MessageImage[]
  files          MessageFile[]
  mentions       MessageMention[]
  reactions      MessageReaction[]
  linkPreviews   MessageLinkPreview[]
  stars          MessageStar[]
  shares         ResourceShare[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([conversationId, pinnedAt])
