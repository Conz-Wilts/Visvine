generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Space {
  id                 String                 @id
  name               String
  description        String?
  location           String?
  tags               String[]               @default([])
  createdAt          DateTime               @default(now()) @map("created_at")
  imageUrl           String?                @map("image_url")
  nodeTypes          Json?                  @default("[{\"name\": \"Person\", \"color\": \"#60a5fa\", \"shape\": \"rectangle\"}, {\"name\": \"Space\", \"color\": \"#78d870\", \"shape\": \"square\"}, {\"name\": \"Event\", \"color\": \"#fb7185\", \"shape\": \"rectangle\"}]") @map("node_types")
  aliases            Json?                  @default("[{\"id\": \"admin\", \"name\": \"Admin\", \"color\": \"#b4881b\", \"admin\": true, \"system\": true, \"nodeType\": \"Person\"}]")
  linkTypes          Json?                  @default("[{\"name\": \"Related\", \"color\": \"#94a3b8\", \"directed\": false}, {\"name\": \"Knows\", \"color\": \"#2563eb\", \"directed\": false}, {\"name\": \"Works at\", \"color\": \"#9333ea\", \"directed\": true}, {\"name\": \"Founded\", \"color\": \"#16a34a\", \"directed\": true}, {\"name\": \"Invested in\", \"color\": \"#f59e0b\", \"directed\": true}, {\"name\": \"Member of\", \"color\": \"#0ea5e9\", \"directed\": true}, {\"name\": \"Partner\", \"color\": \"#ec4899\", \"directed\": false}, {\"name\": \"Mentors\", \"color\": \"#14b8a6\", \"directed\": true}, {\"name\": \"Attended\", \"color\": \"#ef4444\", \"directed\": true, \"system\": true}, {\"name\": \"Hosting\", \"color\": \"#ef4444\", \"directed\": true, \"system\": true}, {\"name\": \"Introduced\", \"color\": \"#06b6d4\", \"directed\": false, \"system\": true}, {\"name\": \"Mentioned\", \"color\": \"#8b5cf6\", \"directed\": false, \"system\": true}]") @map("link_types")
  designConfig       Json                   @default("{}") @map("design_config")
  featureConfig      Json                   @default("{}") @map("feature_config")
  // Set = a private, single-member "personal space" owned by this user (created on
  // first use to host their personal context notes). Null = a normal space.
  // Filtered out of Discover / other users' space lists.
  personalOwnerId    String?                @map("personal_owner_id")
  // "public" = discoverable & self-joinable from Discover; "private" = hidden from
  // Discover / non-members' lists, joinable only via invite link or admin add.
  // A sub-space's visibility is its own, independent of its parent's: a
  // public sub-space inside a private space is listed and joinable, and its
  // context is read into the parent's (lib/spaces/subspaces.ts).
  // Private by default: a space someone forgot to set visibility on must err
  // toward hidden, never toward discoverable (demo seeds opt into public).
  visibility         String                 @default("private")
  // Set = this is a sub-space of that space (one level: a sub-space never
  // holds sub-spaces, lib/spaces/subspaces.ts#parentDenial). Its own tenant
  // in every other table — members, aliases, tools, context — with the parent
  // named here and nowhere else. Restrict, not cascade: deleting a space with
  // sub-spaces is a deliberate children-first delete, never a silent wipe.
  parentId           String?                @map("parent_id")
  parent             Space?                 @relation("SpaceChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children           Space[]                @relation("SpaceChildren")
  // Rooms in a house (docs/sub-spaces.md). Four dials a sub-space sets for
  // itself; `visibility` above stays what every gate reads.
  // Listing — who can see the room exists: 'secret' | 'house' | 'world'.
  // Only meaningful with `visibility` (world ⇔ public); see subspaces.ts#listingOf.
  listing            String                 @default("house")
  // Doors — who may enter without an invite, 'invite' | 'ask' | 'open': one
  // for the parent's members, one for everyone else (never wider).
  houseDoor          String                 @default("ask") @map("house_door")
  worldDoor          String                 @default("open") @map("world_door")
  // What flows up into the parent, each the room's own switch; none for a
  // secret room, whatever these say.
  flowContext        Boolean                @default(true) @map("flow_context")
  flowEvents         Boolean                @default(true) @map("flow_events")
  // Whether the parent's admins administer this sub-space too (lib/auth.ts
  // #isAdmin). On when a parent's admin creates the room; switching it off is
  // the room's own act and only a holder of the room's own admin alias can
  // switch it back on.
  parentAdmins       Boolean                @default(false) @map("parent_admins")
  // The house's side of the wall: { modelKeys, hiddenFromBand }
  // (lib/spaces/subspaces.ts#subspaceConfigOf).
  subspaceConfig     Json                   @default("{}") @map("subspace_config")
  // Reusable, revocable invite token. Regenerating overwrites it, invalidating the
  // previously shared link. Null until first generated.
  inviteToken        String?                @unique @map("invite_token")
  // IANA zone the space's scheduled agents run in when an agent doesn't name
  // its own (lib/agents/config.ts). Null = UTC. The only other agent-wide
  // setting, the custom model endpoint, is a connector note (lib/connectors/model.ts).
  timezone           String?
  links              Link[]
  nodes              Node[]
  members            SpaceMember[]
  notes              ContextNote[]
  noteFolders        ContextFolder[]
  contextState       ContextState[]
  secrets            ConnectorSecret[]
  oauthClients       ConnectorOAuthClient[]
  connections        ConnectorConnection[]
  connectorRequests  ConnectorRequest[]
  connectorState     ConnectorState[]
  noteEmbeddings     ContextNoteEmbedding[]
  memories           ContextMemory[]
  contextSources     ContextSource[]
  userAliases        UserAlias[]
  contextGrants      ContextGrant[]
  accessRequests     ContextAccessRequest[]
  auditEntries       ContextAuditEntry[]
  moveProposals      ContextMoveProposal[]
  publicationsOut    ContextPublication[]   @relation("PublicationSource")
  publicationsIn     ContextPublication[]   @relation("PublicationTarget")
  agentStates        AgentState[]
  agentRuns          AgentRun[]
  agentSubscriptions AgentSubscription[]
  agentConfigChanges AgentConfigChange[]
  agentChatThreads   AgentChatThread[]
  agentEvents        AgentEvent[]
  agentEgressLog     AgentEgressLog[]
  agentVms           AgentVm[]
  agentVmEvents      AgentVmEvent[]
  agentVmUsage       AgentVmUsage[]
  agentModelUsage    AgentModelUsage[]

  channels        Conversation[]
  channelSections ChannelSection[]

  appToolBuilds      AppToolBuild[]
  appToolCheckRuns   AppToolCheckRun[]
  contextRecords     ContextRecord[]
  appToolConfigs     AppToolConfig[]
  appToolConfigChanges AppToolConfigChange[]
  contextRecordFields ContextRecordField[]
  appToolInstalls    AppToolInstall[]
  appToolRecords     AppToolRecord[]
  sharedToolInstalls AppToolInstall[]      @relation("SharedToolInstalls")
  resources          Resource[]
  resourceShares     ResourceShare[]
  resourceFolders    ResourceFolder[]
  projectionJobs     NoteProjectionJob[]
  cleanSchedule      ContextCleanSchedule?
  cleanRuns          ContextCleanRun[]
  noteChunks         ContextNoteChunk[]
  profileEntries     ProfileSectionEntry[]

  @@index([personalOwnerId])
  @@index([parentId])
  @@map("spaces")
}

/// A markdown note in a space's notes/knowledge surface. Notes live in a
/// "context" identified by (spaceId, ownerKey): ownerKey "shared" = the
/// space-wide context every member sees; any other value is a userId = that
/// user's personal context scoped to this space. `path` is the context-relative
/// POSIX path ("portfolio/canva.md") and doubles as the link-resolution identity,
/// so the pure index/context/backlink pipeline (lib/notes/shared) treats a row exactly
/// like a file on disk. `content` (full markdown incl. YAML frontmatter) is the
/// source of truth. Soft-deleted notes (deletedAt set) are the trash.
model ContextNote {
  id          String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId     String                @map("space_id")
  ownerKey    String                @map("owner_key") // 'shared' = space context; else a userId = personal context
  path        String // context-relative POSIX path, e.g. "portfolio/canva.md"
  content     String // full markdown incl. frontmatter (source of truth)
  createdBy   String                @map("created_by")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  deletedAt   DateTime?             @map("deleted_at") // soft-delete = trash; null = live
  deletedPath String?               @map("deleted_path") // original path while trashed
  space       Space                 @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  revisions   ContextNoteRevision[]

  @@unique([spaceId, ownerKey, path], name: "note_identity")
  @@index([spaceId, ownerKey, deletedAt])
  @@map("context_notes")
}

/// Append-only revision snapshots for a ContextNote (newest by `at`): a baseline
/// is seeded on first edit and every save records a full snapshot,
/// capped/coalesced in lib/notes/store.ts.
model ContextNoteRevision {
  id          String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  noteId      String      @map("note_id")
  at          DateTime    @default(now())
  editor      String // display name of who saved it (from the session)
  editorEmail String?     @map("editor_email")
  origin      String      @default("edit") // NoteRevisionOrigin: edit | ai-refactor | ai-enrich | agent | maintenance | restore | baseline | publish
  model       String? // LLM model (or agent client) name when AI-originated
  content     String // full snapshot (frontmatter + body) at this save
  note        ContextNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, at])
  @@map("context_note_revisions")
}

/// The note write-path OUTBOX: one row per note mutation, enqueued in the SAME
/// transaction as the note row itself, and settled once that write's projections
/// have been rebuilt (directory links, agent state, Tool builds, space-config
/// columns, published replicas, folder indexes).
///
/// Why it exists: the projections in docs/data-architecture.md are "rebuildable
/// by replaying tier 1" — but until this table nothing replayed them. A note was
/// committed and its six side effects then ran as bare awaits, so a crash, a
/// deploy, or a single throwing hook left the declaration saved and its
/// projections silently stale, with no record that they were owed.
///
/// A row here IS that record. `doneAt` null = the projections for this write are
/// still owed; the drain (lib/notes/projections.ts#drainProjections) claims due
/// rows by compare-and-swap and re-runs them, which is safe because every hook
/// on the path is idempotent — re-running one is at worst wasted compute.
///
/// This is a ledger by the §1 test (one row per event) but a self-pruning one:
/// settled rows are deleted, since the durable record of the write is the note
/// revision, not the job.
model NoteProjectionJob {
  id       String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId  String  @map("space_id")
  ownerKey String  @map("owner_key")
  /// Post-mutation path: the new path for a rename, the trashed note's path for
  /// a delete. Together with `kind` this is everything applyProjections needs —
  /// the note CONTENT is re-read from the row, never carried here, so a retry
  /// always projects what the note says NOW rather than replaying a stale copy.
  path     String
  kind     String // write | rename | delete
  fromPath String? @map("from_path") // rename only: the path it moved off

  /// The write's origin + actor, needed because two projections branch on them:
  /// the agent hook must not wake an agent for its own run's write, and the
  /// publication sync must not replicate a replica.
  origin     String  @default("edit")
  actorId    String  @map("actor_id")
  actorName  String  @map("actor_name")
  actorEmail String? @map("actor_email")
  model      String?
  /// Whether the save actually changed the content — the agent hook's
  /// auto-deactivate rule fires on a real edit, not on a no-op re-save.
  changed    Boolean @default(true)

  attempts  Int       @default(0)
  lastError String?   @map("last_error")
  createdAt DateTime  @default(now()) @map("created_at")
  /// Not before this instant. Set to now() on enqueue and pushed out by an
  /// exponential backoff on each failure.
  runAfter  DateTime  @default(now()) @map("run_after")
  /// Non-null = settled. Rows are deleted on success; this column exists so a
  /// drain can mark-then-delete without a second lookup, and so a poisoned row
  /// that exhausted its attempts can be parked rather than retried forever.
  doneAt    DateTime? @map("done_at")
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  /// The drain's only query: due, unsettled, oldest first.
  @@index([doneAt, runAfter])
  @@index([spaceId, ownerKey, path])
  @@map("note_projection_jobs")
}

/// Explicitly-created folders for a context. Notes already imply their ancestor
/// folders, but this table lets empty folders exist and be renamed; the tree
/// builder grafts these in alongside note-derived folders. `restricted` and
/// `locked` are the shared context's folder-boundary flags (lib/notes/shared/authz.ts):
/// a restricted folder cuts ContextGrant inheritance at its boundary (only grants on
/// or inside it reach its notes); a locked folder is frozen for AI maintenance.
/// Flagging a folder that only exists implicitly upserts its row first.
/// A note that declares one of the space's member-invented types (a
/// `NodeTypeConfig` with `scope: note`) — a record the Directory's table
/// lists and a query searches. Derived from the note on every write
/// (lib/records/projection.ts) and dropped with it; the note is the truth.
model ContextRecord {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  ownerKey  String   @map("owner_key")
  path      String
  /// The type's name as the space spells it.
  type      String
  title     String
  tags      String[] @default([])
  /// When the note itself was last saved.
  updatedAt DateTime @map("updated_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path], name: "context_record_identity")
  @@index([spaceId, ownerKey, type])
  @@map("context_records")
}

/// One field value of a record: what its note's frontmatter says under a key
/// its type declares, typed by the field's kind into one of the value columns
/// — or `invalid` when it does not read as that kind. Any note writer can set
/// frontmatter, so a value is judged here rather than refused at the write;
/// `raw` keeps what was written so a table can show it as wrong.
model ContextRecordField {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId     String    @map("space_id")
  ownerKey    String    @map("owner_key")
  path        String
  type        String
  key         String
  textValue   String?   @map("text_value")
  numberValue Float?    @map("number_value")
  dateValue   DateTime? @map("date_value")
  boolValue   Boolean?  @map("bool_value")
  raw         String?
  invalid     Boolean   @default(false)
  space       Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path, key], name: "context_record_field_identity")
  @@index([spaceId, ownerKey, type, key])
  @@map("context_record_fields")
}

model ContextFolder {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String   @map("space_id")
  ownerKey   String   @map("owner_key")
  path       String
  restricted Boolean  @default(false)
  locked     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path], name: "folder_identity")
  @@map("context_folders")
}

/// Control-plane sidecar for a context. One row per named file per context: the
/// folder registry ("folders.json"), the access-seeding marker
/// ("access-state.json") and the context settings ("settings.json"). Content is
/// JSON text; the domain layer (lib/notes/sidecar.ts) owns parsing. Keyed like
/// notes so personal contexts can also carry state. The audit log, join
/// requests and move proposals each have a table of their own.
model ContextState {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  ownerKey  String   @map("owner_key") // 'shared' or a userId, same as ContextNote
  name      String // e.g. "folders.json", "audit.jsonl"
  content   String
  updatedAt DateTime @updatedAt @map("updated_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, name], name: "context_state_identity")
  @@map("context_state")
}

/// A named secret a connector note can reference as {{secret:NAME}}. The value
/// is AES-256-GCM encrypted with the server-wide SECRETS_KEY (lib/crypto/secrets.ts)
/// and only ever decrypted server-side while executing a connector call — the
/// admin API lists names but never returns plaintext.
model ConnectorSecret {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String   @map("space_id")
  name       String // ^[A-Z][A-Z0-9_]{0,63}$
  ciphertext String // aes256gcm$iv$tag$cipher
  createdBy  String?  @map("created_by") // admin email, for the audit trail
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, name], name: "secret_identity")
  @@map("connector_secrets")
}

/// A connector's registered OAuth client, per Space. Usually obtained by
/// dynamic registration (RFC 7591) at first connect — which is what lets an MCP
/// server be added without anyone signing up for a developer account — but a
/// note may also name a client_id it registered by hand.
model ConnectorOAuthClient {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId      String   @map("space_id")
  /// Matches ConnectorAuth.provider from the note's `auth:` block.
  provider     String
  /// Authorization-server issuer the client is registered with. A note that
  /// repoints at a different issuer must re-register, so this is part of the key.
  issuer       String
  clientId     String   @map("client_id")
  /// aes256gcm$iv$tag$cipher, or null for a public client.
  clientSecret String?  @map("client_secret")
  createdAt    DateTime @default(now()) @map("created_at")
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, provider, issuer], name: "oauth_client_identity")
  @@map("connector_oauth_clients")
}

/// One stored OAuth connection: the tokens Visvine holds on someone's behalf.
///
/// `userId` is the empty string for a `mode: space` connection and the
/// member's id for `mode: user`. Empty string rather than NULL because Postgres treats
/// NULLs as distinct in a unique index, which would let two space connections
/// exist for the same connector.
model ConnectorConnection {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId      String    @map("space_id")
  provider     String
  /// '' for space mode; the member's User id for user mode.
  userId       String    @default("") @map("user_id")
  /// 'user' | 'space' — recorded so a mode change in the note is detectable.
  mode         String
  /// What the far side calls this account, shown as "acts as …". Never a secret.
  accountLabel String?   @map("account_label")
  /// aes256gcm$iv$tag$cipher
  accessToken  String    @map("access_token")
  /// aes256gcm$iv$tag$cipher. Absent when the provider issues no refresh token.
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  scopes       String[]  @default([])
  /// Set when a refresh has failed unrecoverably — the connection needs a human
  /// to reconnect. Kept rather than deleted so the UI can say which, and why.
  brokenAt     DateTime? @map("broken_at")
  brokenReason String?   @map("broken_reason")
  connectedBy  String?   @map("connected_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, provider, userId], name: "connection_identity")
  @@index([spaceId, provider])
  @@map("connector_connections")
}

/// A person's OWN account at a service, connected once in Settings → Accounts
/// and spent in every space they act in (lib/connectors/accounts.ts). There is
/// no note: the perimeter is the catalogue recipe's, rendered at load, so
/// nothing a space or a person writes can widen it. `name` is what a brief
/// declares — the recipe's id, then `<recipe>-2` for a second account.
/// `offSpaces` is the person's own list of spaces this account stays out of.
model ConnectorAccount {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String    @map("user_id")
  name         String
  recipe       String
  accountLabel String?   @map("account_label")
  /// aes256gcm$iv$tag$cipher
  accessToken  String    @map("access_token")
  /// aes256gcm$iv$tag$cipher. Absent when the provider issues no refresh token.
  refreshToken String?   @map("refresh_token")
  expiresAt    DateTime? @map("expires_at")
  scopes       String[]  @default([])
  brokenAt     DateTime? @map("broken_at")
  brokenReason String?   @map("broken_reason")
  offSpaces    String[]  @default([]) @map("off_spaces")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name], name: "account_identity")
  @@map("connector_accounts")
}

/// The OAuth client a person's account signs in through, where the server
/// registers one dynamically (an MCP server). A platform client lives in env
/// and has no row here.
model ConnectorAccountClient {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String   @map("user_id")
  recipe       String
  issuer       String
  clientId     String   @map("client_id")
  /// aes256gcm$iv$tag$cipher, or null for a public client.
  clientSecret String?  @map("client_secret")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recipe, issuer], name: "account_client_identity")
  @@map("connector_account_clients")
}

/// A member's ask that the space CONNECT a service it does not have yet — filed
/// from the account menu's All connectors list, where a recipe the space holds
/// no connector for offers Request instead of Connect. `recipe` is the catalog
/// entry's id (lib/connectors/catalog.ts). A SPACE ADMIN resolves it from the
/// console's Connectors section: Add runs the recipe and stamps the note it
/// wrote in `connectorName`; Dismiss closes it. Access to a connector the space
/// already has is a ContextAccessRequest on its note, not one of these.
model ConnectorRequest {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId       String    @map("space_id")
  userId        String    @map("user_id")
  recipe        String
  message       String?
  status        String    @default("pending") // 'pending' | 'added' | 'dismissed'
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedBy    String?   @map("resolved_by")
  resolvedAt    DateTime? @map("resolved_at")
  connectorName String?   @map("connector_name")
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
  @@index([userId])
  @@map("connector_requests")
}

/// A connector's small memory between runs — `visvine.state.get/set` inside
/// the isolate (lib/connectors/hostState.ts). Keyed by the connector NOTE path
/// rather than a connector id because a connector is a note; renaming the note
/// starts fresh, which is the honest outcome. Same caps as a Tool's state:
/// 16KB a value, 100 keys a connector.
model ConnectorState {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  /// `connectors/<name>.md`
  path      String
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, path, key], name: "connector_state_identity")
  @@map("connector_state")
}

/// One Space agent's record (lib/agents). The row is HOW it runs — model,
/// reach, schedule, identity, share, caps — and is authoritative; the note
/// `agents/<name>/index.md` is WHAT it is: title, description, tags and the
/// brief itself. Written only through lib/agents/service.ts#configureAgent,
/// so "who is due" is one indexed query and overlap suppression is an atomic
/// compare-and-swap on `status` that survives ten Cloud Run instances.
model AgentState {
  id                  String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId             String     @map("space_id")
  name                String // agent name = the folder under agents/
  runAsUserId         String?    @map("run_as_user_id") // the brief's author; the principal a run acts as
  briefNoteId         String?    @map("brief_note_id") // the context_notes row this state was derived from; a different id at the same name is a NEW agent, and the old one's runs go with it
  active              Boolean    @default(false)
  status              String     @default("idle") // idle | running
  nextRunAt           DateTime?  @map("next_run_at")
  lastRunAt           DateTime?  @map("last_run_at")
  runningSince        DateTime?  @map("running_since")
  currentRunId        String?    @map("current_run_id") // the AgentRun holding the `running` claim; release is a CAS on it
  budgetMonthlyCents  Int?       @map("budget_monthly_cents") // null = uncapped
  deactivatedReason   String?    @map("deactivated_reason") // DeactivationReason: brief_changed | key_rejected | repeated_failure | author_gone | renamed | deleted | admin | config
  deactivatedDetail   String?    @map("deactivated_detail") // e.g. who edited the brief
  consecutiveFailures Int        @default(0) @map("consecutive_failures")
  triggersJson        Json?      @map("triggers_json") // the live note's parsed `on:` map — { context: [globs], webhook: name }
  sharedFrom          String?    @map("shared_from") // a run-in copy: the HOUSE whose brief this row runs, in this room (lib/agents/hooks.ts#syncSharedCopies)
  debounceMs          Int        @default(60000) @map("debounce_ms") // how far forward an event pulls next_run_at
  // ── How it runs: the record, not a cache. `configured_at` null = a row from
  // before the record existed, still read from the note (lib/agents/record.ts).
  model               String? // a pinned `<provider>/<id>`; null runs on the space's model
  fallbackModel       String?    @map("fallback_model") // tried once when a run on `model` ends short (lib/agents/runner.ts)
  connectors          String[]   @default([])
  tools               String[]   @default([]) // AGENT_TOOL_EXTRAS
  agents              String[]   @default([]) // agents it may start with run_agent
  schedule            Json? // AgentSchedule (lib/agents/config.ts); null = trigger-only or off
  timezone            String?
  runsAs              String?    @map("runs_as") // an explicit identity; admin-held
  shareMode           String     @default("none") @map("share_mode") // none | all | rooms
  shareRooms          String[]   @default([]) @map("share_rooms")
  shareAs             String     @default("use") @map("share_as") // use | run-in
  dryRun              Boolean    @default(false) @map("dry_run")
  maxTurns            Int        @default(40) @map("max_turns")
  inputs              Json? // AgentInput[] (lib/agents/shared/inputs.ts): the values each person supplies for themselves
  inputValues         Json?      @map("input_values") // the agent's own identity's values for those inputs
  configuredAt        DateTime?  @map("configured_at")
  updatedBy           String?    @map("updated_by")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  space               Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  runs                AgentRun[]

  @@unique([spaceId, name], name: "agent_identity")
  @@index([active, nextRunAt])
  @@index([sharedFrom])
  @@map("agent_state")
}

/// A member who has put their name down to have an agent run FOR them: each
/// scheduled fire runs once per subscriber, as that subscriber's principal, so
/// a `mode: user` connector resolves THEIR linked account (lib/agents/schedule.ts
/// fan-out). Keyed by a bare user_id, so lib/account/deleteAccount.ts clears it.
model AgentSubscription {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  name      String // agent name = folder basename under agents/
  userId    String   @map("user_id")
  at        String? // "HH:MM", their own time on a daily or weekly agent
  timezone  String?
  model     String? // their own model; null rides the agent's
  inputs    Json? // their own values for the agent's inputs (lib/agents/shared/inputs.ts)
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, name, userId], name: "agent_subscription_identity")
  @@index([spaceId, name])
  @@map("agent_subscriptions")
}

/// Who changed how an agent runs, and to what — the history a note revision
/// used to be for these fields (lib/agents/service.ts#configureAgent).
model AgentConfigChange {
  id      String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId String   @map("space_id")
  name    String
  userId  String?  @map("user_id") // null for a machine write
  patch   Json
  at      DateTime @default(now())
  space   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, name, at(sort: Desc)])
  @@map("agent_config_changes")
}

/// One execution of a Space agent — the run record and its transcript. Written
/// first-hand by the executor (lib/agents/runner.ts): usage, cost, terminal
/// reason and the `AgentEvent` trace (tool results clipped, secrets already
/// redacted by the isolate). Monthly spend is SUM(costMicros) by startedAt.
model AgentRun {
  id               String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  stateId          String     @map("state_id")
  spaceId          String     @map("space_id")
  name             String
  trigger          String // RunTrigger: scheduled | manual | event | webhook | interval
  status           String     @default("running") // running | succeeded | failed
  startedAt        DateTime   @default(now()) @map("started_at")
  endedAt          DateTime?  @map("ended_at")
  startedBy        String?    @map("started_by") // userId for manual runs
  runAsUserId      String?    @map("run_as_user_id") // whose principal this run acted as; null = the state row's runAsUserId
  model            String?
  promptTokens     Int        @default(0) @map("prompt_tokens")
  completionTokens Int        @default(0) @map("completion_tokens")
  costMicros       BigInt?    @map("cost_micros") // USD micro-dollars; null = pricing unknown
  turns            Int        @default(0)
  terminalReason   String?    @map("terminal_reason") // finished | max_turns | narrated | incomplete | budget | run_cap | timeout | crashed | error | auth | quota | upstream | config | author_gone | aborted
  summary          String? // the model's final answer, capped
  errorMessage     String?    @map("error_message") // redacted
  events           Json       @default("[]") // AgentEvent[] trace
  eventCount       Int        @default(0) @map("event_count") // agent_events rows this run consumed
  input            Json? // { events: [{ kind, source, summary, at }] } — the "Triggered by …" block
  state            AgentState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  space            Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([stateId, startedAt(sort: Desc)])
  @@index([spaceId, startedAt])
  @@map("agent_runs")
}

/// The payload mailbox behind reactive agents (lib/agents/events.ts). A note
/// save under an `on.context` glob, an inbound webhook, or a human reply
/// inserts one row and pulls the agent's next_run_at forward; the tick's claim
/// then stamps `consumedBy` with the run id and the run reads them as input.
/// The partial indexes (pending per agent; unique dedupe_key while pending)
/// live in the hand-written migration — Prisma can't express WHERE clauses.
model AgentEvent {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String   @map("space_id")
  agentName  String   @map("agent_name")
  kind       String // note_written | webhook | reply
  source     String // note path / connector name / who replied
  summary    String
  payload    Json     @default("{}")
  dedupeKey  String?  @map("dedupe_key")
  createdAt  DateTime @default(now()) @map("created_at")
  consumedBy String?  @map("consumed_by") // AgentRun.id once claimed
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([consumedBy])
  @@map("agent_events")
}

/// Single-row liveness record for the agent scheduler tick. If it stops
/// moving, every agent in every space goes quiet with nothing failing — this
/// is how the panel tells a Space that the watcher itself is down.
model AgentHeartbeat {
  id         Int      @id @default(1)
  lastTickAt DateTime @map("last_tick_at")

  @@map("agent_heartbeat")
}

/// One agent's machine: the lease, not the machine itself.
///
/// The runtime scales to zero and is N processes, so nothing may hold a handle
/// to a container across requests. This row is the handle: every request
/// re-derives the machine from it, and the substrate is addressed by
/// `substrateName` rather than by anything we hold in memory.
///
/// The container's disk is ephemeral — it is thrown away whenever the machine
/// sleeps — so `workspaceKey` (an R2 prefix belonging to the SPACE) is where
/// anything durable lives. `policyHash` is the compiled egress policy the
/// current session was started under, so a machine can be checked against what
/// it was booted with rather than what the space happens to permit now.
model AgentVm {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId       String    @map("space_id")
  agentName     String    @map("agent_name")
  substrate     String    @default("cloudflare")
  substrateName String    @map("substrate_name")
  instanceType  String    @default("standard-3") @map("instance_type")
  /// provisioning | running | asleep | reaping | unavailable | dead
  state         String    @default("provisioning")
  policyHash    String?   @map("policy_hash")
  /// R2 prefix for the space's shared volume — outlives every agent that touches it.
  workspaceKey  String    @map("workspace_key")
  lastActiveAt  DateTime? @map("last_active_at")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  space         Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, agentName], name: "vm_identity")
  @@index([state, lastActiveAt])
  @@map("agent_vms")
}

/// How much machine a space has used this month.
///
/// Awake seconds are what a machine costs, so they are what a quota counts. The
/// tick adds its own interval for every machine it finds awake — the platform's
/// timer is what bills, so the platform's timer is what meters. One row per
/// space per month, because a cap that resets is the only kind anyone can plan
/// against.
model AgentVmUsage {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  /// First instant of the UTC month this counts.
  month     DateTime
  seconds   Int      @default(0)
  /// Commands run, for a bill that says what the seconds were spent on.
  execs     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, month], name: "usage_identity")
  @@map("agent_vm_usage")
}

/// The durable spend record: what each agent spent on each model, per space per
/// UTC month, incremented when a run finishes (lib/agents/runs.ts#finishRun) the
/// way the tick increments AgentVmUsage. agent_runs rows are pruned (90 days /
/// 100 per agent); these survive, so "what did March cost" has an answer.
/// A person's standing conversation with one agent in one space — the mobile
/// Messages → Agents thread (docs/agents.md § Chat). NOT a run: it never
/// touches agent_state, the mailbox or the schedule. Each turn is one chat on
/// the space's model with the brief as system prompt and the agent's tools,
/// acting as the person. Cascades from users (the delete-account guard) and
/// spaces. `pendingMessageId` is the per-thread turn claim: one turn at a time
/// across N instances, stale after CHAT_CLAIM_MS (lib/agents/shared/chat.ts).
model AgentChatThread {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId          String             @map("space_id")
  agentName        String             @map("agent_name")
  userId           String             @map("user_id")
  lastMessageAt    DateTime?          @map("last_message_at")
  /// First ~160 chars of the newest message, for the list row.
  lastPreview      String?            @map("last_preview")
  /// When the person last opened the thread; unread = lastMessageAt > this.
  lastReadAt       DateTime?          @map("last_read_at")
  pendingMessageId String?            @map("pending_message_id")
  pendingSince     DateTime?          @map("pending_since")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  space            Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         AgentChatMessage[]

  @@unique([spaceId, agentName, userId], name: "chat_identity")
  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([spaceId, agentName])
  @@map("agent_chat_threads")
}

/// One bubble of a thread. An assistant row is written `pending` when the turn
/// is claimed and finished with its text, trace and metering (or `failed` and
/// a reason), so a turn that outlives the request is never lost.
model AgentChatMessage {
  id               String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  threadId         String          @map("thread_id")
  role             String // user | assistant
  text             String
  status           String          @default("done") // pending | done | failed
  /// Assistant rows: why the turn ended — finished | max_turns | budget | timeout | error | narrated
  reason           String?
  errorMessage     String?         @map("error_message")
  /// Assistant rows: compact tool trace, [{ tool, detail, ok }], capped (shared/chat.ts#compactTrace)
  trace            Json?
  model            String?
  turns            Int             @default(0)
  promptTokens     Int             @default(0) @map("prompt_tokens")
  completionTokens Int             @default(0) @map("completion_tokens")
  costMicros       BigInt?         @map("cost_micros")
  createdAt        DateTime        @default(now()) @map("created_at")
  thread           AgentChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt(sort: Desc)])
  @@map("agent_chat_messages")
}

/// Tokens are BigInt because a month of runs outgrows what one run never will.
/// No user key — spend belongs to the space — so deleteAccount owes it nothing.
model AgentModelUsage {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId          String   @map("space_id")
  /// First instant of the UTC month, attributed by run start like spendForMonth.
  month            DateTime
  name             String
  /// The brief's `provider/modelId`, as agent_runs.model records it.
  model            String
  runs             Int      @default(0)
  promptTokens     BigInt   @default(0) @map("prompt_tokens")
  completionTokens BigInt   @default(0) @map("completion_tokens")
  /// Sum of known costs; unpriced runs add tokens here but no dollars.
  costMicros       BigInt   @default(0) @map("cost_micros")
  /// How many of `runs` had no price — what "tokens only" means in a bill.
  unpricedRuns     Int      @default(0) @map("unpriced_runs")
  updatedAt        DateTime @updatedAt @map("updated_at")
  space            Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, month, name, model], name: "usage_identity")
  @@map("agent_model_usage")
}

/// Platform-wide model prices, USD per million tokens, refreshed nightly from
/// public catalogues (OpenRouter's models API, LiteLLM's community price map —
/// lib/agents/prices.ts). The last resort of the pricing chain: a connector
/// note's `pricing:` and the code registry are both consulted first
/// (lib/agents/providers.ts#resolveModelPricing), so nothing fetched can
/// override a price an admin declared or the registry pinned. No space key —
/// prices are facts about providers, not about tenants.
model AgentModelPrice {
  provider        String
  model           String
  inputPerM       Float    @map("input_per_m")
  outputPerM      Float    @map("output_per_m")
  cachedInputPerM Float?   @map("cached_input_per_m")
  /// Which catalogue this row came from: openrouter | litellm.
  source          String
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([provider, model], name: "price_identity")
  @@map("agent_model_prices")
}

/// What an agent's machine did, in order — the window's durable half.
///
/// The screen is ephemeral and the terminal is a stream; this is the record
/// that outlives both, so a run nobody watched is still reviewable afterwards
/// from what it decided, ran and got back. Events arrive in batches from the
/// edge, which owns no rows: `seq` is assigned there so the order survives a
/// batch arriving late, and `at` is the machine's own clock.
///
/// Output is clipped per event and the stream is capped per run — a timeline
/// that grows without bound stops being a record and becomes a cost.
model AgentVmEvent {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  agentName String   @map("agent_name")
  runId     String?  @map("run_id")
  seq       Int
  /// boot | wake | exec | output | exit | sleep | error | egress_denied
  kind      String
  payload   Json     @default("{}")
  at        DateTime
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, agentName, at])
  @@index([runId, seq])
  @@map("agent_vm_events")
}

/// Every request an agent's machine made, and what the edge did about it.
///
/// This is the detection surface for a compromised or injected agent: anomalous
/// destinations, exfil-shaped payloads and repeated denials all read from here.
/// A denial is the system working as designed, so it is written at `warn` and
/// never at `error` — routing policy denials to error reporting is how real
/// failures get buried.
///
/// Records arrive in batches from apps/agent-edge, which owns no rows of its
/// own. There is no foreign key to a run: a machine can be awake between runs,
/// and a record that could not be attributed is still evidence.
model AgentEgressLog {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  agentName String   @map("agent_name")
  runId     String?  @map("run_id")
  method    String
  host      String
  path      String
  /// allow | deny | approval
  verdict   String
  /// Why it was refused, in the words the agent was given.
  reason    String?
  status    Int?
  bytes     Int?
  at        DateTime
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, at])
  @@index([spaceId, agentName, verdict])
  @@map("agent_egress_log")
}

/// A space's own compiled snapshot of one `tools/<name>/` Tool note (lib/tools).
/// Written by the store hook on every save of `index.md`/`ui.md`/`data.md`:
/// esbuild compiles the sources, `errors`/`warnings` are the `CompileDiagnostic[]`
/// shown back to the author, `config` is the parsed+validated frontmatter (or
/// null when `configError` explains why parsing failed). This is the AUTHOR'S
/// working copy — publishing snapshots one into the immutable AppToolVersion
/// registry, so nothing here is ever read by an install.
model AppToolBuild {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId     String   @map("space_id")
  name        String
  sourceHash  String   @map("source_hash") // hash of index.md+ui.md+data.md at compile time
  ok          Boolean
  uiBundle    String?  @map("ui_bundle") // compiled ESM, null when compilation failed
  dataBundle  String?  @map("data_bundle")
  errors      Json     @default("[]") // CompileDiagnostic[]
  warnings    Json     @default("[]") // CompileDiagnostic[]
  sizeBytes   Int      @map("size_bytes")
  config      Json? // parsed ToolConfig, or null when configError is set
  configError String?  @map("config_error")
  /// The author's own rail glyph from icon.md — ALREADY SANITIZED by
  /// lib/tools/iconSvg.ts. Null when the Tool uses a built-in icon. Stored
  /// sanitized on purpose: this is what the rail renders, and nothing
  /// downstream re-parses author markup.
  iconSvg     String?  @map("icon_svg")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, name], name: "app_tool_build_identity")
  @@map("app_tool_builds")
}

/// The IMMUTABLE version registry: one row per published Tool version, keyed
/// `<sourceSpaceId>/<name>` + `version`. Publishing snapshots the author's
/// current AppToolBuild here; once approved a version never changes — an
/// upgrade is a new row, never an update to this one. `sourceSpaceId` is a
/// plain string, NOT a foreign key: a published version must survive its
/// authoring space being deleted, since other spaces may already have it
/// installed.
///
/// TWO INDEPENDENT VERDICTS, because publishing and listing are two decisions:
///   • `status` is the SOURCE SPACE's — its admin approving code written in it.
///     `approved` is what makes a version installable, and it never reaches
///     beyond that space's own subtree.
///   • `marketplaceStatus` is VISVINE's, and it is NULL until someone asks for
///     it. Only `approved` there puts a version on the global shelf or lets a
///     space outside the author's lineage install it.
/// A Tool written in a private space therefore stays in it: nothing is offered
/// to the world without a second, explicit act.
model AppToolVersion {
  id                     String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  key                    String // `<sourceSpaceId>/<name>`
  name                   String
  version                Int
  title                  String
  description            String?
  authorUserId           String?          @map("author_user_id")
  sourceSpaceId          String           @map("source_space_id") // no FK — must outlive the source space
  config                 Json // validated ToolConfig at publish time
  perimeter              Json // declared reach: note globs / types / connectors / agents
  indexSource            String           @map("index_source") // index.md body (docs) at publish time
  uiSource               String           @map("ui_source") // ui.tsx source at publish time
  dataSource             String           @map("data_source") // data.js source at publish time
  /// The interface's own modules at publish time, by file (`src/chart.tsx`) —
  /// read by review and export beside ui.tsx; bundled into `uiBundle`.
  modules                Json             @default("{}")
  /// The Tool's own rail glyph, sanitized at build time (lib/tools/iconSvg.ts)
  /// and snapshotted here so an install carries it. Null = uses a built-in.
  iconSvg                String?          @map("icon_svg")
  uiBundle               String           @map("ui_bundle") // compiled ESM
  dataBundle             String           @map("data_bundle") // compiled ESM
  sizeBytes              Int              @map("size_bytes")
  /// The source space's own verdict: pending | approved | rejected | withdrawn.
  /// An admin publishing approves as they publish; a member publishing queues.
  status                 String           @default("pending") // pending | approved | rejected | withdrawn
  submittedAt            DateTime         @default(now()) @map("submitted_at")
  reviewedBy             String?          @map("reviewed_by")
  reviewedAt             DateTime?        @map("reviewed_at")
  reviewNote             String?          @map("review_note")
  /// Visvine's verdict on a global listing, and NULL while nobody has asked for
  /// one — the column that keeps a private space's Tool private. Same four
  /// values as `status`, decided by a super-admin in the review queue.
  marketplaceStatus      String?          @map("marketplace_status")
  marketplaceSubmittedAt DateTime?        @map("marketplace_submitted_at")
  marketplaceReviewedBy  String?          @map("marketplace_reviewed_by")
  marketplaceReviewedAt  DateTime?        @map("marketplace_reviewed_at")
  marketplaceReviewNote  String?          @map("marketplace_review_note")
  /// Marketplace metadata, snapshotted at publish (migration 20260821130000):
  /// the author's own "what changed" text, the index.md `tags:` list and the
  /// `preview:` image URL. Immutable like every other snapshot column.
  releaseNotes           String?          @map("release_notes")
  tags                   String[]         @default([])
  previewUrl             String?          @map("preview_url")
  /// Pulled after approval — by the source space's admins, or by a Visvine
  /// reviewer. Separate from `status` (the review's outcome): a revoked version
  /// was approved, and stops everywhere it runs, rooms included, at its next
  /// bridge call (lib/tools/verdicts.ts).
  revokedAt              DateTime?        @map("revoked_at")
  revokedBy              String?          @map("revoked_by")
  revokeReason           String?          @map("revoke_reason")
  /// The global listing this version belongs to once it was offered for one —
  /// kept across a transfer, so a version written by another publisher still
  /// upgrades the installs that follow the listing.
  listingId              String?          @map("listing_id")
  /// A space admin asking Visvine to list this version, and the author's
  /// consent to it. Visvine's queue (`marketplaceStatus: pending`) starts only
  /// once both are set; an admin who is the author co-signs as they ask.
  listingRequestedBy     String?          @map("listing_requested_by")
  listingRequestedAt     DateTime?        @map("listing_requested_at")
  cosignedBy             String?          @map("cosigned_by")
  cosignedAt             DateTime?        @map("cosigned_at")
  /// The license the author co-signed under: an SPDX id or `proprietary`.
  license                String?
  /// SHA-256 of each package file (`src/ui.tsx`, `visvine-tool.json`, …) and of
  /// the whole (lib/tools/package) — what an export's CHECKSUMS carries.
  digests                Json             @default("{}")
  packageDigest          String?          @map("package_digest")
  createdAt              DateTime         @default(now()) @map("created_at")
  author                 User?            @relation("AppToolVersionAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  listing                AppToolListing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  installs               AppToolInstall[]
  checkRuns              AppToolCheckRun[]
  reviewRuns             AppToolReviewRun[]

  @@unique([key, version], name: "app_tool_version_identity")
  @@index([status, submittedAt])
  @@index([marketplaceStatus, marketplaceSubmittedAt], map: "app_tool_versions_marketplace_status_idx")
  @@index([listingId])
  @@map("app_tool_versions")
}

/// A Tool installed into a space, pinned to one AppToolVersion. `key` mirrors
/// the pinned version's key so lookups don't need a join; `requirements` is the
/// missing-connectors/types/agents snapshot from the last check (an unmet
/// requirement degrades the Tool, it never blocks install); `typeClaims` is the
/// admin-confirmed set of context types this install owns a page/tab for.
/// `pendingVersionId` names an approved newer AppToolVersion awaiting an
/// admin-triggered upgrade — deliberately NOT a foreign key, so an admin can
/// still see "an upgrade is available" even if that row were ever withdrawn.
model AppToolInstall {
  id                String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId           String         @map("space_id")
  versionId         String         @map("version_id")
  key               String
  slug              String // rail slug: tool:<slug>
  enabled           Boolean        @default(true)
  installedBy       String         @map("installed_by")
  requirements      Json           @default("{}") // { connectors: string[]; types: string[]; agents: string[] } — MISSING items at last check
  typeClaims        Json           @default("{}") @map("type_claims") // { [typeName]: 'page' | 'tab' }
  /// What each of the version's binding slots is bound to here — a folder,
  /// type, connector or agent of this space (@visvine/tool-protocol bindings).
  bindings          Json           @default("{}")
  /// The values of the version's install-time settings, as an admin set them.
  settings          Json           @default("{}")
  pendingVersionId  String?        @map("pending_version_id")
  /// Set when this install is the HOUSE's Tool shared down into this room
  /// (lib/tools/share.ts): the room runs it, the house owns it.
  sharedFromSpaceId String?        @map("shared_from_space_id")
  /// The listing this install follows when it came from one: upgrades are
  /// offered by listing, so they keep coming after the listing is transferred.
  listingId         String?        @map("listing_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  space             Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  sharedFromSpace   Space?         @relation("SharedToolInstalls", fields: [sharedFromSpaceId], references: [id], onDelete: Cascade)
  version           AppToolVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  state             AppToolState[]
  consents          AppToolConsent[]
  telemetry         AppToolTelemetry[]

  @@unique([spaceId, key], name: "app_tool_install_identity")
  @@unique([spaceId, slug], name: "app_tool_install_slug")
  @@index([sharedFromSpaceId])
  @@index([listingId])
  @@map("app_tool_installs")
}

/// A row of a Tool's COLLECTION: the per-install store a manifest declares by
/// name, JSON Schema and read/write rules (lib/tools/collections.ts). Keyed by
/// what the Tool runs as (`targetKey`: the install, or a working copy's
/// preview), written by one person (`userId`, never shown to other viewers —
/// only whether a row is theirs), and gone with that person's account. An
/// uninstall DETACHES the rows rather than deleting them: a re-install of the
/// same Tool in the space takes them back, and the minute tick drops what has
/// stayed detached for 30 days.
model AppToolRecord {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String    @map("space_id")
  /// The install's id, or `preview:<space>/<name>` for a working copy.
  targetKey  String    @map("target_key")
  /// The Tool's key (`<source-space>/<name>`) — what a re-install is matched by.
  toolKey    String    @map("tool_key")
  collection String
  userId     String    @map("user_id")
  data       Json
  detachedAt DateTime? @map("detached_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  space      Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetKey, collection, createdAt, id])
  @@index([targetKey, collection, userId])
  @@index([spaceId, toolKey])
  @@index([detachedAt])
  @@index([userId])
  @@map("app_tool_records")
}

/// A member's answer to a listed Tool's first-use notice: "this Tool from
/// outside the space will act as you". Remembered per install and person, with
/// the acting reach it was given for (lib/tools/shared/listing.ts#ActingReach)
/// — an upgrade that widens what the Tool does as them asks again.
model AppToolConsent {
  id          String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  installId   String         @map("install_id")
  userId      String         @map("user_id")
  acting      Json           @default("{}")
  consentedAt DateTime       @default(now()) @map("consented_at")
  install     AppToolInstall @relation(fields: [installId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([installId, userId], name: "app_tool_consent_identity")
  @@index([userId])
  @@map("app_tool_consents")
}

/// Per-install key/value state written through the Tool bridge's `visvine.state`
/// capability (a Tool's iframe runs sandboxed without `allow-same-origin`, so it
/// has no localStorage — this is its persistence instead).
model AppToolState {
  id        String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  installId String         @map("install_id")
  /// '' for a value every viewer of the install shares (scope `install`); the
  /// viewer's id for their own (scope `user`), cleared with their account.
  userId    String         @default("") @map("user_id")
  key       String
  value     Json
  updatedAt DateTime       @updatedAt @map("updated_at")
  install   AppToolInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@unique([installId, userId, key], name: "app_tool_state_identity")
  @@index([userId])
  @@map("app_tool_state")
}

/// A Tool's global listing: one row per Tool Visvine has listed or been asked
/// to. Its `state` is Visvine's hold over the listing as a whole — `suspended`
/// (reversible) or `revoked` (permanent) stops every install OUTSIDE the
/// publisher's own space at its next bridge call, whatever version it pins.
///
/// The id is the listing's identity and outlives its key: a listing
/// TRANSFERRED to another publisher names that space's Tool from then on, and
/// the installs that follow it (`app_tool_installs.listing_id`) keep being
/// offered its upgrades.
model AppToolListing {
  id               String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  key              String           @unique // the Tool key the listing currently names
  publisherSpaceId String           @map("publisher_space_id") // no FK — a listing outlives its space's rows
  state            String           @default("active") // active | suspended | revoked
  stateReason      String?          @map("state_reason")
  stateBy          String?          @map("state_by")
  stateAt          DateTime?        @map("state_at")
  /// The author who co-signed the listing, and the license they chose.
  authorUserId     String?          @map("author_user_id")
  license          String?
  /// When Visvine first listed a version of it.
  listedAt         DateTime?        @map("listed_at")
  /// Staged reach: until this moment at most `stagedCap` spaces outside the
  /// publisher's family may install it, and its per-viewer bridge rate is
  /// halved. Set at the first listing of an unverified publisher.
  stagedUntil      DateTime?        @map("staged_until")
  stagedCap        Int?             @map("staged_cap")
  /// A transfer offered to another publisher space, waiting on its admins.
  transferTo       String?          @map("transfer_to")
  transferBy       String?          @map("transfer_by")
  transferAt       DateTime?        @map("transfer_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  versions         AppToolVersion[]

  @@map("app_tool_listings")
}

/// The global stages Visvine runs on a version offered for listing — the AI
/// review and the dynamic run against a throwaway honeypot space — as one
/// queued job the minute tick drains (lib/tools/review). The findings land in
/// `app_tool_check_runs` as stages `ai` and `dynamic`; this row keeps the run
/// itself: where it ran, the canaries it planted and what came of it.
model AppToolReviewRun {
  id              String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  versionId       String               @map("version_id")
  status          String               @default("queued") // queued | running | passed | flagged | blocked | unavailable | error
  /// Which browser ran it: local | machine | none.
  runner          String?
  /// The honeypot space made for this run; deleted when the run ends.
  honeypotSpaceId String?              @map("honeypot_space_id")
  runnerUserId    String?              @map("runner_user_id")
  /// token → { path, restricted } — what was planted, never what was read.
  canaries        Json                 @default("{}")
  attempts        Int                  @default(0)
  error           String?
  startedAt       DateTime?            @map("started_at")
  finishedAt      DateTime?            @map("finished_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  version         AppToolVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  events          AppToolReviewEvent[]

  @@index([status, createdAt])
  @@index([versionId, createdAt])
  @@map("app_tool_review_runs")
}

/// What a Tool did during its dynamic run: every bridge call it made, every
/// write, every call to a door out of the space (recorded, never performed),
/// and every CSP report, navigation and egress attempt the browser saw.
model AppToolReviewEvent {
  id     String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  runId  String           @map("run_id")
  kind   String // bridge | door | csp | navigation | egress | console
  method String?
  detail Json             @default("{}")
  at     DateTime         @default(now())
  run    AppToolReviewRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, at])
  @@map("app_tool_review_events")
}

/// A Tool's structured facts — its surfaces and its manifest's reach,
/// bindings, settings, platforms, kit range, dependencies and collections —
/// one row per Tool per space. The index note keeps the prose (title,
/// description, tags, docs); this is what a machine enforces or places. Both
/// are read as one index note (lib/tools/toolFacts.ts#composeToolIndex), and
/// written through `writeToolFacts`, which keeps every change below.
model AppToolConfig {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  name      String
  /// The fact keys as the author declared them (`surfaces`, `permissions`, …).
  facts     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, name], name: "app_tool_config_identity")
  @@map("app_tool_configs")
}

/// Every change to a Tool's facts, one row per key that moved: who, when, and
/// what it was before and after.
model AppToolConfigChange {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  name      String
  key       String
  before    Json?
  after     Json?
  /// Who, by name — the person or the system that wrote it.
  actor     String
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, name, createdAt])
  @@map("app_tool_config_changes")
}

/// One stage of the automated checks over a Tool — compatibility or security,
/// and for a version offered for listing the global stages, ai and dynamic —
/// as it ran on a working copy (`versionId` null) or on the version a publish
/// wrote (lib/tools/checks/). The author, the space's admins and a Visvine
/// reviewer all read this row: nothing is re-run for a person. A version's
/// rows outlive its space the way the version does (`spaceId` goes null).
model AppToolCheckRun {
  id         String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String?         @map("space_id")
  name       String
  versionId  String?         @map("version_id")
  sourceHash String          @map("source_hash")
  stage      String // compatibility | security | ai | dynamic
  status     String // passed | flagged | blocked
  trigger    String // check | publish | rescan | review
  findings   Json            @default("[]")
  /// The permission risk score, security stage only: { score, level, factors }.
  risk       Json?
  /// Which rules ran — a rescan re-reads versions an older analyzer passed.
  analyzer   String
  durationMs Int             @map("duration_ms")
  createdAt  DateTime        @default(now()) @map("created_at")
  space      Space?          @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  version    AppToolVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([spaceId, name, createdAt])
  @@index([versionId, createdAt])
  @@map("app_tool_check_runs")
}

/// Something a running Tool did that a person should look at: a frame that
/// navigated itself, a CSP violation, a report. Counts and facts only, never
/// the viewer's content. `viewerId` is redacted when that person deletes their
/// account; the incident stays.
model AppToolIncident {
  id         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  kind       String // navigation | csp | report | canary | anomaly | rescan
  severity   String // severe | flag | quality | report
  status     String    @default("open") // open | cleared | confirmed
  /// Who saw it: a viewer's browser, Visvine's dynamic run, the monitor's
  /// rules, or a rescan. Suspension weighs them differently (lib/tools/monitor.ts).
  source     String    @default("viewer") // viewer | dynamic | monitor | rescan
  key        String?
  /// The listing the Tool was installed from, when it was — what a hold acts on.
  listingId  String?   @map("listing_id")
  versionId  String?   @map("version_id")
  installId  String?   @map("install_id")
  spaceId    String?   @map("space_id")
  viewerId   String?   @map("viewer_id")
  detail     Json      @default("{}")
  /// The reviewer who cleared or confirmed it, and when.
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@index([status, createdAt])
  @@index([listingId, status])
  @@map("app_tool_incidents")
}

/// A publishing space as Visvine knows it: whether Visvine has verified it is
/// who it says it is. A verified publisher's listings are not staged after
/// its first, and its re-listings that change nothing reviewed and come back
/// clean from every stage are listed without a person (registry.ts#shouldAutoApprove).
/// Keyed by the space, and kept when the space goes — a listing outlives it.
model AppToolPublisher {
  spaceId    String    @id @map("space_id")
  verified   Boolean   @default(false)
  verifiedBy String?   @map("verified_by")
  verifiedAt DateTime? @map("verified_at")
  /// The reviewer's own words about this publisher.
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("app_tool_publishers")
}

/// What each install of a Tool did, as counts — never content — one row per
/// install, day and server instance. Each instance adds up in memory and, on
/// the request path once a minute has passed, adds its counts to ITS OWN row,
/// so no row is written by two instances and N instances still sum
/// (lib/tools/telemetry.ts). Rolled into one row per install and day when the
/// day is over, and kept 90 days.
model AppToolTelemetry {
  id          String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  installId   String         @map("install_id")
  versionId   String         @map("version_id")
  day         DateTime       @db.Date
  /// The server instance that counted these, or `day` once rolled up.
  instance    String
  calls       Int            @default(0)
  refusals    Int            @default(0)
  /// method → { calls, refusals: { code: n } }.
  methods     Json           @default("{}")
  bytesRead   BigInt         @default(0) @map("bytes_read")
  bytesWritten BigInt        @default(0) @map("bytes_written")
  /// Distinct note paths read in each flush, summed — an upper bound.
  paths       Int            @default(0)
  dataMs      Int            @default(0) @map("data_ms")
  aiTokens    Int            @default(0) @map("ai_tokens")
  cspReports  Int            @default(0) @map("csp_reports")
  navigations Int            @default(0)
  frameErrors Int            @default(0) @map("frame_errors")
  /// Distinct viewers in each flush, summed — an upper bound.
  viewers     Int            @default(0)
  updatedAt   DateTime       @updatedAt @map("updated_at")
  install     AppToolInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@unique([installId, day, instance], name: "app_tool_telemetry_identity")
  @@index([day])
  @@map("app_tool_telemetry")
}

/// A known advisory against a curated dependency at the version Visvine
/// vendors (lib/tools/advisories.ts, from OSV). A new one makes every listed
/// version that declares the package a rescan's business.
model AppToolAdvisory {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  package    String
  version    String
  advisoryId String   @map("advisory_id")
  summary    String
  severity   String // low | medium | high
  url        String?
  fetchedAt  DateTime @default(now()) @map("fetched_at")

  @@unique([package, version, advisoryId], name: "app_tool_advisory_identity")
  @@map("app_tool_advisories")
}

/// Which of its space's PERSON ALIASES a member holds. The aliases themselves
/// live in `Space.aliases` (lib/types/context.ts#SpaceAlias) — the same
/// vocabulary that colours a person's chip in the directory IS the permission
/// model, so this points into a JSON array rather than at another table.
///
/// It points at `SpaceAlias.id`, NOT the name. Holding an alias is what makes
/// someone an admin (lib/auth.ts#isAdmin), and a name is editable: keying on it
/// meant every rename had to rewrite this table, `ContextGrant.subjectId` and
/// `Node.alias` in step, and any drift — a casing mismatch, a half-applied
/// cascade — silently revoked people's access. An id is not editable, so a
/// rename is now one write to `Space.aliases` and nothing here moves.
///
/// A person holds any number of them, with no restrictions on which. An alias
/// marked `admin` there means its holders manage the space; the built-in
/// Admin alias (id `admin`) always does. Rows are deleted when the user leaves
/// the space (lib/notes/access.ts#removeMemberAccess) — grants stop matching
/// instantly.
model UserAlias {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String   @map("space_id")
  userId    String   @map("user_id")
  aliasId   String   @map("alias_id")
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId, aliasId], name: "user_alias_identity")
  @@index([userId])
  @@index([spaceId, aliasId])
  @@map("user_aliases")
}

/// One access grant on a space's SHARED context: *subject* gets *level* on
/// *resource*. The whole permission model (lib/notes/shared/authz.ts) reduces to
/// these rows plus the `restricted` folder flags: access flows down the folder
/// tree from `resourcePath` ('' = context root, a folder path at any depth, or a
/// single note path), a restricted folder cuts inheritance at its boundary, and
/// a member's effective level on a note is the MAX across every grant that
/// reaches it (space-wide + their aliases' + their own). Grants only ever add.
model ContextGrant {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId      String   @map("space_id")
  subjectType  String   @map("subject_type") // 'space' | 'alias' | 'user' | 'channel'
  // '' for the space itself | SpaceAlias.id | userId. Alias grants hold the
  // alias's stable id, never its name — see the note on UserAlias.
  subjectId    String   @default("") @map("subject_id")
  resourcePath String   @default("") @map("resource_path") // '' = context root
  // 10 view · 30 edit — the only two levels, enforced by a CHECK. Permissions
  // ABOUT a resource (sharing, restricting, deleting a folder) are a space-admin
  // power, not a level. See lib/notes/shared/authz.ts.
  level        Int
  grantedBy    String   @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at")
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, subjectType, subjectId, resourcePath], name: "grant_identity")
  @@map("context_grants")
}

/// A member's request for access to part of a space's SHARED context, filed
/// from whatever surface denied them (`resourcePath` '' = the context root gate, a
/// folder, or a single note path — the path is recorded even when it doesn't
/// exist, so the denial copy never has to admit whether it does). A SPACE ADMIN
/// resolves it: approval writes a ContextGrant at exactly the requested path
/// (lib/notes/accessRequests.ts). Resolved rows are kept as the audit trail
/// behind Console → People → Waiting.
model ContextAccessRequest {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId      String    @map("space_id")
  userId       String    @map("user_id")
  resourcePath String    @default("") @map("resource_path") // '' = context root
  level        Int       @default(10) // the level asked for (10 view · 30 edit; see ContextGrant.level)
  message      String?
  status       String    @default("pending") // 'pending' | 'approved' | 'denied'
  createdAt    DateTime  @default(now()) @map("created_at")
  resolvedBy   String?   @map("resolved_by")
  resolvedAt   DateTime? @map("resolved_at")
  grantedLevel Int?      @map("granted_level") // what the resolver actually gave
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
  @@index([userId])
  @@map("context_access_requests")
}

/// A live publish link between two contexts: the source note stays owned by its
/// context, and a replica lives as a REAL note row in the target space's
/// shared context, overwritten on every source save (origin 'publish'). No read
/// path ever crosses a space boundary — the only cross-tenant motion is the
/// replicating write (lib/notes/publications.ts). `active: false` (unlink, or a
/// deleted source/replica) leaves the replica behind as a plain editable copy.
model ContextPublication {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceSpaceId String    @map("source_space_id")
  sourcePath    String    @map("source_path")
  targetSpaceId String    @map("target_space_id")
  targetPath    String    @map("target_path")
  active        Boolean   @default(true)
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  sourceSpace   Space     @relation("PublicationSource", fields: [sourceSpaceId], references: [id], onDelete: Cascade)
  targetSpace   Space     @relation("PublicationTarget", fields: [targetSpaceId], references: [id], onDelete: Cascade)

  @@unique([sourceSpaceId, sourcePath, targetSpaceId], name: "publication_identity")
  @@index([sourceSpaceId, sourcePath])
  @@index([targetSpaceId, targetPath])
  @@map("context_publications")
}

/// A queued publish/promotion proposal: someone wants a note of theirs to live
/// in a shared folder they cannot write to, and a folder admin approves or
/// denies it (lib/notes/promote.ts). Same shape and same reason as
/// ContextAccessRequest — a pending queue with an in-place resolution — which
/// is why it stopped being the "move-proposals.jsonl" sidecar blob: resolving
/// one used to rewrite every proposal in the space, so two admins acting at
/// once lost one of the decisions.
///
/// `content` is the markdown snapshot taken at proposal time. For a 'publish'
/// proposal it is only the preview: approval reads the proposer's CURRENT note
/// and creates a live publication instead of copying this.
model ContextMoveProposal {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId      String    @map("space_id")
  fromSpaceId  String?   @map("from_space_id") // the source space; null on rows from before it was recorded, whose source was the proposer's `me:` space
  fromPath     String    @map("from_path") // in the source space's context
  toPath       String    @map("to_path") // in this space's SHARED context
  folderId     String    @map("folder_id")
  content      String
  kind         String    @default("copy") // 'copy' | 'publish'
  proposedBy   String    @map("proposed_by")
  proposerName String    @map("proposer_name")
  proposedAt   DateTime  @default(now()) @map("proposed_at")
  status       String    @default("pending") // 'pending' | 'approved' | 'denied'
  resolvedBy   String?   @map("resolved_by")
  resolvedAt   DateTime? @map("resolved_at")
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, status])
  @@index([proposedBy])
  @@map("context_move_proposals")
}

/// LEDGER (docs/data-architecture.md). One row per audited context event: a read
/// inside a restricted boundary, or any governance mutation (folder registry
/// changes, grants, promotions, gated moves/deletes, connector calls, agent
/// activations, secret changes, Tool lifecycle). First-hand and NOT derivable
/// from anything — losing a row loses history.
///
/// Replaced the "audit.jsonl" ContextState sidecar, where every append rewrote
/// the whole blob and concurrent appends silently dropped entries. `name` is
/// the actor's display name captured at the time of the event, deliberately
/// denormalized so the trail still reads correctly after a rename or deletion.
model ContextAuditEntry {
  id      String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId String   @map("space_id")
  at      DateTime @default(now())
  userId  String   @map("user_id")
  name    String
  action  String
  path    String
  detail  String?
  space   Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, at(sort: Desc)])
  @@map("context_audit_entries")
}

/// The pgvector projection of a note, keyed like the note itself.
///
/// No foreign key to `ContextNote` and there cannot be one: a note's identity is
/// (space_id, owner_key, path), which is a unique constraint rather than the
/// primary key, and the path moves on rename. So the row's LIFECYCLE is code's
/// job, not the database's — pruned on delete and rename by the note write path
/// (lib/notes/projections.ts) and reconciled by the nightly sweep
/// (lib/notes/embedSweep.ts). Before both existed nothing pruned them at all and
/// every deleted or renamed note left its vector behind for good.
model ContextNoteEmbedding {
  id        String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String                      @map("space_id")
  ownerKey  String                      @map("owner_key")
  path      String
  model     String // embedding model name; rows from an old model are ignored
  mtime     BigInt // note updatedAt (epoch ms) when embedded
  embedding Unsupported("vector(768)")?
  updatedAt DateTime                    @updatedAt @map("updated_at")
  space     Space                       @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path], name: "embedding_identity")
  @@map("context_note_embeddings")
}

/// One embedded chunk of a context note — the retrieval unit that keeps a
/// paragraph of a long note findable (lib/notes/shared/noteChunks.ts splits,
/// lib/notes/embedSweep.ts embeds, lib/notes/chunkStage.ts ranks). Every hit
/// folds onto its note in the fusion, so a result is still a note and carries
/// the matching passage. Keyed like `context_note_embeddings` — no foreign key,
/// dropped with the note on delete/rename (projections.ts#dropEmbedding),
/// reconciled by the sweep — and `mtime` is the note's when it was chunked: the
/// stage matches (path, mtime) against the live notes, so chunks of an older
/// save are never served. `heading` is the section path the chunk sits under.
model ContextNoteChunk {
  id        String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId   String                      @map("space_id")
  ownerKey  String                      @map("owner_key")
  path      String
  seq       Int // 0-based order within the note
  heading   String                      @default("")
  text      String
  mtime     BigInt // note updatedAt (epoch ms) when chunked
  model     String? // embedding model; null = stored without a vector
  embedding Unsupported("vector(768)")?
  updatedAt DateTime                    @updatedAt @map("updated_at")
  space     Space                       @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path, seq], name: "note_chunk_identity")
  @@index([spaceId, ownerKey, model])
  @@map("context_note_chunks")
}

/// One derived memory: a single self-contained claim extracted from a context
/// note by the memory sweep (lib/notes/memorySweep.ts). Search ranks over these
/// as a stage of its own (lib/notes/memoryStage.ts) and folds each hit onto its
/// source note, so a result can carry the ~50-token sentence that answered
/// rather than a 1 KB excerpt. Keyed like `context_note_embeddings` — no foreign
/// key, pruned on delete/rename by the write path and reconciled nightly — and
/// `mtime` is the note's when the claims were extracted: a row whose mtime no
/// longer matches its note is from an older version and is never served. A
/// note that yielded no claims keeps one row with `text = ''` (seq 0) so the
/// sweep knows it was read; the stage skips it.
model ContextMemory {
  id         String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String                      @map("space_id")
  ownerKey   String                      @map("owner_key")
  path       String
  seq        Int // 0-based order within the note
  text       String
  model      String // chat model that extracted the claim
  mtime      BigInt // note updatedAt (epoch ms) when extracted
  embedModel String?                     @map("embed_model") // embedding model; null = stored without a vector
  embedding  Unsupported("vector(768)")?
  updatedAt  DateTime                    @updatedAt @map("updated_at")
  space      Space                       @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, ownerKey, path, seq], name: "memory_identity")
  @@map("context_memories")
}

/// A non-note source (uploaded file/table) attached to a context. Lives ONLY in
/// the Context — never a Node, never in the workspace/directory. Keyed
/// (spaceId, ownerKey, path) exactly like ContextNote so the folder gate
/// and visibility lens apply to sources unchanged; `path` must NOT end in .md
/// (the note namespace stays disjoint). The original file lives in GCS; the
/// extracted text lives chunked in ContextSourceChunk.
model ContextSource {
  id         String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId    String               @map("space_id")
  ownerKey   String               @map("owner_key") // 'shared' or a userId, same as ContextNote
  path       String // context-relative POSIX path incl. filename, e.g. "deals/pricing.csv"
  name       String // display filename
  kind       String // SourceKind: csv | markdown | text | json | docx | spreadsheet
  mimeType   String               @map("mime_type")
  sizeBytes  Int                  @map("size_bytes")
  gcsPath    String               @map("gcs_path") // object in GCS_RESOURCES_BUCKET
  status     String               @default("pending") // pending | ready | failed
  error      String? // failure detail when status = failed
  truncated  Boolean              @default(false) // extraction hit the text/chunk caps
  textChars  Int?                 @map("text_chars") // extracted-text length
  chunkCount Int                  @default(0) @map("chunk_count")
  createdBy  String               @map("created_by")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")
  space      Space                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  chunks     ContextSourceChunk[]

  @@unique([spaceId, ownerKey, path], name: "source_identity")
  @@index([spaceId, ownerKey, status])
  @@map("context_sources")
}

/// One embedded chunk of a ContextSource. spaceId/ownerKey/path are
/// denormalized from the source so the pgvector ranking query filters without a
/// join (as in context_note_embeddings). `text` is the source of truth for
/// snippets and paged source reads; `embedding` is written/read via raw SQL.
model ContextSourceChunk {
  id        String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceId  String                      @map("source_id")
  spaceId   String                      @map("space_id")
  ownerKey  String                      @map("owner_key")
  path      String
  seq       Int // 0-based order within the source
  text      String
  model     String? // embedding model; null = stored without a vector
  embedding Unsupported("vector(768)")?
  source    ContextSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, seq])
  @@index([spaceId, ownerKey, model])
  /// The chunk stages filter (space_id, owner_key, model, path IN <visible>).
  /// The index above reaches the context; this one also cuts to the visible
  /// files, which is the selective half — see migration
  /// 20260824120000_retrieval_index_correction.
  @@index([spaceId, ownerKey, path])
  @@map("context_source_chunks")
}

model Node {
  id             String          @id
  type           String
  name           String
  subtitle       String?
  location       String?
  url            String?
  tags           String[]        @default([])
  imageUrl       String?         @map("image_url")
  metadata       Json            @default("{}")
  spaceId        String?         @map("space_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  // The alias chip this card wears, as a NAME. Overloaded: for an event it is
  // the public /e/<slug> slug, for a connector the executor kind — neither of
  // which is vocabulary. Read through lib/types/context.ts#findAlias, which only
  // treats it as an alias when the space actually defines one by that name for
  // this node's type. Display and search only; `aliasId` is the truth.
  alias          String?
  // The space alias this card wears (`SpaceAlias.id`). Survives renames, which
  // the name copy above does not — see the note on UserAlias.
  aliasId        String?         @map("alias_id")
  // Canonical cross-space identity this node represents (people/orgs). Nullable:
  // legacy rows and non-person/org types may have none. Set by lib/identity/resolve.
  identityId     String?         @map("identity_id")
  identity       Identity?       @relation(fields: [identityId], references: [id], onDelete: SetNull)
  attendees      EventAttendee[] @relation("EventNode")
  attendeePerson EventAttendee[] @relation("PersonNode")
  linksAsSource  Link[]          @relation("SourceNode")
  linksAsTarget  Link[]          @relation("TargetNode")
  space          Space?          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  resource       Resource?

  @@index([type])
  @@index([spaceId, type])
  @@index([identityId])
  @@index([spaceId, aliasId])
  @@map("nodes")
}

model Link {
  id           Int      @id @default(autoincrement())
  sourceId     String   @map("source_id")
  targetId     String   @map("target_id")
  relationship String
  since        String?
  metadata     Json     @default("{}")
  spaceId      String?  @map("space_id")
  createdAt    DateTime @default(now()) @map("created_at")
  // Provenance + dedup. `pairKey` is the
  // normalized "minId|maxId" of the two endpoints so A->B and B->A dedup as one
  // edge; always computed by lib/context/links.ts upsertLink, never raw-written blank.
  origin       String   @default("manual") @map("origin") // manual | event_attendance | event_hosting | intro | context | structure | import
  originRef    String?  @map("origin_ref") // EventAttendee.id / IntroRequest.id / event node id / context-note path / contained node id — for symmetric auto-undo
  createdBy    String?  @map("created_by") // userId for manual links; null for system/auto
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  pairKey      String   @map("pair_key")
  space        Space?   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  source       Node     @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Node     @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([spaceId, pairKey, relationship], name: "link_identity") // dedup; origin deliberately NOT in the key
  @@index([sourceId])
  @@index([targetId])
  @@index([pairKey])
  @@map("links")
}

model EventAttendee {
  id           String    @id
  eventId      String    @map("event_id")
  personId     String?   @map("person_id")
  name         String? // typed guest name (loginless RSVP; no Person node required)
  email        String?
  linkedinUrl  String?   @map("linkedin_url")
  companyName  String?   @map("company_name")
  roleTitle    String?   @map("role_title")
  answers      Json      @default("{}")
  // Operational lifecycle: going | waitlisted | pending | checked_in | no_show | cancelled | invited
  // (a CHECK constraint holds the list).
  status       String    @default("going")
  // Guest's intent, separate from the operational status: going | maybe | declined.
  response     String?
  plusOnes     Int       @default(0) @map("plus_ones")
  plusOneNames String[]  @default([]) @map("plus_one_names")
  invitedBy    String?   @map("invited_by") // userId/personId who invited/added them
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  checkinAt    DateTime? @map("checkin_at")
  event        Node      @relation("EventNode", fields: [eventId], references: [id], onDelete: Cascade)
  person       Node?     @relation("PersonNode", fields: [personId], references: [id])

  @@unique([eventId, email]) // dedupe RSVPs by email (NULL emails remain distinct in Postgres)
  @@index([eventId, status])
  @@index([personId])
  @@index([email])
  @@map("event_attendees")
}

/// A registered account.
///
/// WHICH COLUMNS POINT AT A USER, AND WHY MOST OF THEM ARE NOT FOREIGN KEYS.
/// `space_id` is foreign-keyed on 27 of the 28 tables that carry it; user
/// identity is not, and the asymmetry is deliberate rather than an oversight —
/// but only for three specific reasons, and everything outside them is a real
/// reference and now really a key (see the relation list below).
///
///  1. **Polymorphic keys.** `owner_key` on every personal-context table is
///     `'shared'` OR a userId; `ConnectorConnection.userId` is `''` for a
///     space-owned connection. A column with a sentinel value cannot be a
///     foreign key at all.
///  2. **Provenance stamps, not references.** `created_by`, `uploaded_by`,
///     `granted_by`, `proposed_by`, `editor` record WHO DID a thing, and the
///     answer is sometimes `'system'`, an agent, or a seed script. They also
///     must survive the person: cascading `Resource.uploaded_by` would delete a
///     SPACE's files because the member who uploaded them closed their account,
///     which is the opposite of correct.
///  3. **Deliberate tombstones.** `ContextAuditEntry.userId` is REDACTED rather
///     than deleted, because an audit log you can erase by closing your account
///     is not an audit log.
///
/// What is left after those three is access and credentials, and those cascade.
///
/// The row is also the person's PROFILE — the fields from `nodeId` down are
/// what /api/profile reads and the profile editor writes. They belong to the
/// account, not to any space: a `Node` is one space's card for a person, and a
/// member's node in each space is reached through their `Identity`. `nodeId`
/// is the id of their own person node — the one in their personal space
/// (lib/spaces/personalSpace.ts) — minted once at first sign-in
/// (lib/auth/bootstrap.ts) and carried in the session as the profile the
/// account menu links to.
model User {
  id           String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  name         String
  email        String        @unique
  image        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  claimNonce   String?       @unique @map("claim_nonce")
  googleId     String?       @unique @map("google_id")
  isActive     Boolean       @default(true) @map("is_active")
  /// Public profile metadata: what a claim import supplied (name, headline,
  /// avatar_url) and what the profile editor keeps here (experience,
  /// themeColor). PATCH /api/profile round-trips it whole as `metadata`.
  publicMeta   Json          @default("{}") @map("public_meta")
  nodeId       String?       @unique @map("node_id")
  subtitle     String?
  bio          String?
  location     String?
  website      String?
  linkedinUrl  String?       @map("linkedin_url")
  twitterUrl   String?       @map("twitter_url")
  phone        String?
  pronouns     String?
  tags         String[]      @default([])
  membersAdded SpaceMember[] @relation("AddedByRelation")
  memberships  SpaceMember[] @relation("MemberOf")

  // --- messaging ---
  conversationMemberships ConversationMember[]
  conversationsCreated    Conversation[]       @relation("ConversationCreator")
  messagesSent            Message[]            @relation("MessageSender")
  messageReactions        MessageReaction[]    @relation("ReactionAuthor")
  messageStars            MessageStar[]        @relation("StarAuthor")
  resourcesCreated        Resource[]           @relation("ResourceCreator")
  resourceShares          ResourceShare[]      @relation("ResourceSharer")
  resourceAccesses        ResourceAccess[]     @relation("ResourceAccessor")

  appToolVersionsAuthored AppToolVersion[] @relation("AppToolVersionAuthor")
  appToolConsents         AppToolConsent[]
  appToolRecords          AppToolRecord[]

  // Deleting a person must take their ACCESS and their CREDENTIALS with it. Each
  // of these was a bare scalar that only lib/account/deleteAccount.ts knew to
  // sweep, so a bug or a new caller could leave an owner alias or an
  // exchangeable refresh token behind a deleted account. They are real
  // references — not provenance stamps — so they are foreign keys now, and the
  // sweep and the database agree instead of only the sweep knowing.
  aliasesHeld             UserAlias[]
  accessRequests          ContextAccessRequest[]
  connectorRequests       ConnectorRequest[]
  connectorAccounts       ConnectorAccount[]
  connectorAccountClients ConnectorAccountClient[]
  agentChatThreads        AgentChatThread[]
  identity                Identity?
  oauthAuthCodes          OAuthAuthCode[]
  profileSections         ProfileSection[]
  following               Follow[]                 @relation("FollowsGiven")
  followers               Follow[]                 @relation("FollowsReceived")

  @@map("users")
}

/// A person's membership of a space. Deliberately carries no role — what
/// they can do comes entirely from the Aliases they hold.
model SpaceMember {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String   @map("user_id")
  spaceId     String   @map("space_id")
  // "active" = full member; "pending" = requested to join via invite link, awaiting
  // admin approval in the space console.
  status      String   @default("active")
  joinedAt    DateTime @default(now()) @map("joined_at")
  addedBy     String?  @map("added_by")
  privateMeta Json     @default("{}") @map("private_meta")
  addedByUser User?    @relation("AddedByRelation", fields: [addedBy], references: [id])
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user        User     @relation("MemberOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, spaceId])
  @@index([spaceId])
  @@map("space_members")
}

/// Canonical, cross-space identity for a real person or organization.
/// Each space keeps its own private `Node` row; all nodes that represent the
/// same real person/org point to ONE Identity (Node.identityId). Spaces never
/// share their per-node data — only identity-level facts live here (canonical name,
/// photo, strong identifiers). Resolution (lib/identity/resolve.ts) decides whether
/// a new node attaches to an existing identity or mints a new one. `userId` links the
/// identity to a registered User when claimed/verified (email/linkedin become
/// authoritative). Strong identifiers are stored normalized and treated as
/// effectively unique per kind by the resolver/backfill.
model Identity {
  kind           String // 'person' | 'organization'
  canonicalName  String   @map("canonical_name")
  nameKey        String   @map("name_key") // normalized name, used for blocking
  imageUrl       String?  @map("image_url")
  email          String? // normalized lowercase (person)
  linkedinHandle String?  @map("linkedin_handle") // normalized "linkedin.com/in/x" (person)
  websiteDomain  String?  @map("website_domain") // normalized bare domain (org)
  metadata       Json     @default("{}") // survivorship signals: { company, location, ... }
  verified       Boolean  @default(false)
  userId         String?  @unique @map("user_id") // set when claimed by a registered User
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  nodes          Node[]
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kind, email])
  @@index([kind, linkedinHandle])
  @@index([kind, websiteDomain])
  @@index([kind, nameKey])
  @@map("identities")
}

/// Append-only audit trail of identity-resolution decisions, for transparency and
/// reversibility. Also records anti-matches: a `rejected` (or `split`) row for a
/// (nodeId, identityId) pair tells the resolver "these are NOT the same" so it never
/// re-suggests or re-auto-merges them. `actorUserId` is null for system decisions.
model IdentityResolution {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  nodeId      String   @map("node_id")
  identityId  String?  @map("identity_id") // candidate or chosen identity
  decision    String // auto_strong | auto_name_company | suggested | created | confirmed | rejected | split | merged
  //          ^ resolver decisions, then review decisions. Enforced by a CHECK
  //            constraint (20260824120200_enum_check_constraints) so this list
  //            cannot drift from what the code writes again.
  confidence  Float    @default(0)
  reason      String // human-readable, e.g. "email match" | "name+company"
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([nodeId])
  @@index([identityId])
  @@index([decision])
  @@map("identity_resolutions")
}

/// One thing a space holds that is not a note: a file whose bytes we store
/// (`source: upload`) or a link we unfurl (`source: link`). A resource is
/// SHARED into places — the space itself, or a channel's message — through
/// `resource_shares`, the way Slack keeps one File and many shares of it; who
/// can see a resource is the union of its shares (lib/resources/shared/visibility.ts).
/// Every resource is also a context entity: `nodeId` names its `resource:` node,
/// whose note at `resources/<slug>/index.md` is the prose about it.
///
/// The three tiers meet on this row (docs/data-architecture.md): `gcsPath` is the
/// tier-3 pointer, this row is the tier-2 record, and `sourcePath` addresses the
/// tier-1 context entry whose chunks carry the contents into retrieval.
model Resource {
  id             String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId        String              @map("space_id")
  name           String
  /// The display bucket older readers key on (pdf, docx, xlsx, image…). `kind`
  /// is the family the viewer and filters read; both are written together.
  fileType       String              @map("file_type")
  source         ResourceSource      @default(upload)
  kind           ResourceKind        @default(other)
  state          ResourceState       @default(ready)
  /// The resource's entity. Unique: one resource, one node, one note.
  nodeId         String?             @unique @map("node_id")
  /// The object in GCS_RESOURCES_BUCKET. SERVER-MINTED, never accepted from a
  /// client: this is the string the API signs a download URL for, so a
  /// client-supplied one would sign any object in the bucket — including another
  /// space's. Null for a link, or a row whose bytes were never stored (a seed).
  gcsPath        String?             @map("gcs_path")
  fileSize       Int?                @map("file_size")
  mimeType       String?             @map("mime_type")
  /// md5 of the stored bytes, from the object store.
  contentHash    String?             @map("content_hash")
  width          Int?
  height         Int?
  durationMs     Int?                @map("duration_ms")
  pageCount      Int?                @map("page_count")
  /// pending | clean | blocked | skipped — what the upload scanner said. Bytes
  /// are served only when clean or skipped (no scanner configured).
  scanState      String              @default("skipped") @map("scan_state")
  /// Unused since resource_shares; awaiting a drop migration.
  uploadedBy     String              @map("uploaded_by")
  createdBy      String?             @map("created_by")
  /// The ContextSource path holding this file's extracted chunks, or null when
  /// the kind carries no text (images). The source row is the RAG projection of
  /// this record and is rebuildable from the GCS object by re-ingesting.
  sourcePath     String?             @map("source_path")
  /// pending | indexed | unsupported | failed — where this file got to in the
  /// RAG pipeline, surfaced in the Drive so "why can't the AI see my file" has a
  /// visible answer instead of silence.
  indexState     String              @default("pending") @map("index_state")
  indexError     String?             @map("index_error")
  metadata       Json                @default("{}")
  // ── a link ──
  url            String?
  /// The dedupe key: the same page shared five times is one resource.
  canonicalUrl   String?             @map("canonical_url")
  /// google-doc | google-sheet | google-slides | google-drive | figma | youtube | loom | vimeo | web
  provider       String?
  /// What the page says about itself: title, description, siteName, authorName,
  /// publishedAt, mediaType, imageLayout, faviconPath. Never oEmbed html.
  unfurl         Json?
  /// An embed URL WE built for an allowlisted provider (lib/links/shared/providers.ts).
  embedUrl       String?             @map("embed_url")
  /// The page's image, re-hosted in the resources bucket — never hotlinked.
  previewPath    String?             @map("preview_path")
  fetchedAt      DateTime?           @map("fetched_at")
  /// pending | ok | failed
  fetchState     String?             @map("fetch_state")
  /// 'scrape', or 'connector:<name>' when the provider's own API supplied it.
  entitySource   String?             @map("entity_source")
  /// What the provider's API said: owner, modifiedAt, size, mimeType.
  external       Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  deletedAt      DateTime?           @map("deleted_at")
  deletedBy      String?             @map("deleted_by")
  /// The Drive folder it sits in; null is the Drive's root. Deleting a folder
  /// moves its files to its parent (see lib/resources/folders.ts) — never to
  /// the bin — so the FK only ever needs to SET NULL as a last resort.
  folderId       String?             @map("folder_id")
  /// Unused since resource_shares (a channel file is a share); awaiting a drop.
  conversationId String?             @map("conversation_id")
  space          Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  node           Node?               @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  creator        User?               @relation("ResourceCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  folder         ResourceFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  changes        ResourceChange[]
  comments       ResourceComment[]
  messages       MessageFile[]
  shares         ResourceShare[]
  renditions     ResourceRendition[]
  accesses       ResourceAccess[]
  jobs           ResourceJob[]

  @@unique([spaceId, canonicalUrl])
  @@index([spaceId, createdAt(sort: Desc)])
  @@index([spaceId, kind, createdAt(sort: Desc)])
  @@index([spaceId, state])
  @@index([spaceId, folderId])
  @@index([spaceId, conversationId])
  @@map("resources")
}

/// Where a resource was shared. `conversationId` null is the space itself (added
/// in Resources, uploaded by an AI); otherwise a channel, and `messageId` the
/// message that carried it. A channel's Files tab is a query over these rows.
model ResourceShare {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId     String        @map("resource_id")
  spaceId        String        @map("space_id")
  conversationId String?       @map("conversation_id")
  messageId      String?       @map("message_id")
  sharedBy       String?       @map("shared_by")
  /// The agent that shared it on sharedBy's behalf, when one did.
  agentName      String?       @map("agent_name")
  /// upload | message | link | action | agent
  via            String        @default("upload")
  position       Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at")
  resource       Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  space          Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sharer         User?         @relation("ResourceSharer", fields: [sharedBy], references: [id], onDelete: SetNull)

  @@unique([messageId, resourceId])
  @@index([resourceId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([spaceId, createdAt(sort: Desc)])
  @@map("resource_shares")
}

/// A derived image of a resource: `thumb` (360), `preview` (2048), `poster`
/// (a video's frame), `page1` (a document's first page). Never the original —
/// downloads always serve the resource's own bytes.
model ResourceRendition {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId String   @map("resource_id")
  kind       String
  gcsPath    String   @map("gcs_path")
  width      Int?
  height     Int?
  mimeType   String   @default("image/webp") @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, kind])
  @@map("resource_renditions")
}

/// Who used a resource and how: every access through the MCP, an agent or the
/// API, and a person's downloads and deletes. `targetNodeId` names what it was
/// used AS (an event whose cover it became, a person whose photo).
model ResourceAccess {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId   String   @map("resource_id")
  spaceId      String   @map("space_id")
  userId       String?  @map("user_id")
  agentName    String?  @map("agent_name")
  runId        String?  @map("run_id")
  /// web | mcp | agent | api
  via          String
  /// read | download | upload | share | use | delete
  action       String
  targetNodeId String?  @map("target_node_id")
  at           DateTime @default(now())
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user         User?    @relation("ResourceAccessor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([resourceId, at(sort: Desc)])
  @@index([spaceId, at(sort: Desc)])
  @@index([userId])
  @@map("resource_access")
}

/// Work a resource still owes: renditions, text extraction, an unfurl. A row,
/// because the runtime scales to zero and throttles CPU after a response — the
/// work is done inside a request (the one that made it, the one that pulls it,
/// or the minute tick), never after one (lib/resources/jobs.ts).
model ResourceJob {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId  String    @map("resource_id")
  /// rendition | extract | unfurl | refresh | scan
  kind        String
  /// queued | running | done | failed
  state       String    @default("queued")
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedUntil DateTime? @map("locked_until")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, kind])
  @@index([state, runAfter])
  @@map("resource_jobs")
}

enum ResourceSource {
  upload
  link
}

enum ResourceKind {
  image
  video
  audio
  pdf
  doc
  sheet
  slides
  text
  code
  archive
  link
  other
}

enum ResourceState {
  uploading
  ready
  failed
  deleted
}

/// A folder in a Space's Drive. Purely organisational: files index, search and
/// preview the same wherever they sit. Nesting is by `parentId`; the root is the
/// absence of a folder, not a row.
model ResourceFolder {
