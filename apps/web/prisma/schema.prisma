}

/// Per-user "saved message" bookmark (Slack-style starring).
model MessageStar {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("StarAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("message_stars")
}

model LinkPreview {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  url         String               @unique
  title       String?
  description String?
  imageUrl    String?              @map("image_url")
  siteName    String?              @map("site_name")
  faviconUrl  String?              @map("favicon_url")
  authorName  String?              @map("author_name")
  /// article | image | video | audio | file — what the URL IS, from its
  /// content type or its oEmbed/og type. A media URL previews as itself.
  mediaType   String?              @map("media_type")
  /// `summary` (small square thumb) or `large` (wide image), from twitter:card.
  imageLayout String?              @map("image_layout")
  /// When the page says it was published (JSON-LD, article:published_time).
  publishedAt DateTime?            @map("published_at")
  fetchedAt   DateTime             @default(now()) @map("fetched_at")
  messages    MessageLinkPreview[]

  @@map("link_previews")
}

model MessageLinkPreview {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId     String      @map("message_id")
  linkPreviewId String      @map("link_preview_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  linkPreview   LinkPreview @relation(fields: [linkPreviewId], references: [id])

  @@index([messageId])
  @@map("message_link_previews")
}

enum ConversationType {
  DM
  GROUP
  CHANNEL
}

enum ConversationMemberRole {
  MEMBER
  ADMIN
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

/// How a CHANNEL conversation renders: classic chat thread or social-feed post cards.
enum ChannelViewMode {
  CHAT
  FEED
}

/// One token bucket for one rate-limit key, shared by every instance.
///
/// The state has to be shared because the deployment is not one process. A
/// per-process Map on a service that scales to --max-instances is not one limit
/// but N of them, and every cold start hands the caller a fresh allowance —
/// which for the login and webhook limiters, the ones an attacker is actively
/// trying to get past, is the difference between a control and a speed bump.
///
/// The row IS the bucket: `tokens` is refilled from the elapsed time on read,
/// inside the same statement that spends one, so concurrent takers serialize on
/// the row lock rather than racing (lib/rateLimit.ts).
///
/// `key` is caller-derived and therefore attacker-influenced on public routes,
/// so it is stored hashed and fixed-width, and full+idle rows are swept — see
/// pruneRateLimits, which the nightly maintenance run calls.
model RateLimitBucket {
  key       String   @id
  tokens    Float
  updatedAt DateTime @default(now()) @map("updated_at")

  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

/// A concurrency cap shared by every instance: `slot` 0..cap-1 of a key is
/// held until `expiresAt`, so a crashed holder frees its slot by itself
/// (lib/rateLimit/leases.ts).
model RateLimitLease {
  key       String
  slot      Int
  holder    String
  expiresAt DateTime @map("expires_at")

  @@id([key, slot])
  @@index([expiresAt])
  @@map("rate_limit_leases")
}

/// The space's nightly pass (lib/notes/cleanSchedule.ts): one row per space,
/// written from the Space Console's General → Nightly, read every minute by the
/// agent tick. It carries no authority of its own — `runAsUserId` is the admin
/// who turned it on, and the pass runs under THEIR principal, so it sees what
/// they see (the visibility lens), writes only where they may write, and skips
/// folders frozen for AI. A sub-space never holds one: its context is a
/// parent's read-only federated folder, and cleaning happens in the space that
/// owns the notes (lib/notes/shared/cleanSchedule.ts#cleanScheduleDenial).
model ContextCleanSchedule {
  spaceId         String    @id @map("space_id")
  enabled         Boolean   @default(false)
  /// Wall-clock hour in the space's timezone (Space.timezone, UTC when unset).
  hour            Int       @default(3)
  minute          Int       @default(30)
  /// UNUSED since the console collapsed to clean/embed/time (2026-09): a
  /// scheduled clean is always light, whole-space, every safe fix, and embeds
  /// whenever embedEnabled is on. Kept so a deploy's old image still reads the
  /// table; drop mode/targetPath/applyFixes/fixKinds/embedAfterClean in a
  /// follow-up migration once no image selects them.
  mode            String    @default("light") // light | full
  targetPath      String?   @map("target_path")
  applyFixes      Boolean   @default(true) @map("apply_fixes")
  fixKinds        String[]  @default([]) @map("fix_kinds")
  runAsUserId     String    @map("run_as_user_id")
  /// Whether this space's notes are embedded at all — the nightly sweep, the
  /// query-time catch-up and the scheduled pass all read it. With a schedule it
  /// also embeds new or edited notes at hour:minute (after the clean when
  /// `enabled`). No row = on. The tick fires a row when enabled OR embedEnabled.
  embedEnabled    Boolean   @default(true) @map("embed_enabled")
  embedAfterClean Boolean   @default(true) @map("embed_after_clean")
  updatedBy       String?   @map("updated_by")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// The next instant the tick may claim this row. Advanced by the claim
  /// itself, so N instances racing produce one run.
  nextRunAt       DateTime? @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@map("context_clean_schedules")
}

/// One clean pass, scheduled or pressed. The dashboard's history: what the
/// runner could see, what was in its scope, what it wrote, and what it left
/// for a person — `worklist` is the judgment work, never applied.
model ContextCleanRun {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  spaceId         String    @map("space_id")
  trigger         String // scheduled | manual
  status          String    @default("running") // running | succeeded | failed | skipped
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  /// userId who pressed the old Run now; null for a scheduled fire.
  startedBy       String?   @map("started_by")
  /// Whose principal the pass acted as.
  runAsUserId     String    @map("run_as_user_id")
  mode            String    @default("light")
  targetPath      String?   @map("target_path")
  /// Notes the runner could READ (the visibility lens), and of those the ones
  /// inside its scope (owned + targeted + writable).
  analyzedNotes   Int       @default(0) @map("analyzed_notes")
  inScopeNotes    Int       @default(0) @map("in_scope_notes")
  safeFixes       Int       @default(0) @map("safe_fixes")
  applied         Int       @default(0)
  appliedByKind   Json      @default("{}") @map("applied_by_kind")
  /// Fixes a gate refused at write time: [{ path, reason }].
  skipped         Json      @default("[]")
  /// The judgment work left over: [{ kind, count, items: [{ path, detail }] }].
  worklist        Json      @default("[]")
  /// Full mode analysed only the first FULL_MODE_NOTE_CAP notes.
  truncated       Boolean   @default(false)
  /// What the post-clean embed did: off | no-key | skipped | succeeded | failed.
  embedStatus     String    @default("skipped") @map("embed_status")
  embeddedNotes   Int       @default(0) @map("embedded_notes")
  embeddedChunks  Int       @default(0) @map("embedded_chunks")
  embeddedSources Int       @default(0) @map("embedded_sources")
  embedMessage    String?   @map("embed_message")
  errorMessage    String?   @map("error_message")
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId, startedAt(sort: Desc)])
  @@map("context_clean_runs")
}

/// One person following another, across every space. A follow is not membership
/// and grants nothing: it is a stated interest, read by the profile header and
/// nothing else. Both sides are foreign keys so a deleted account takes its
/// follows with it.
model Follow {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  followerId String   @map("follower_id")
  followeeId String   @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at")
  follower   User     @relation("FollowsGiven", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("FollowsReceived", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

/// A section a member adds to their own profile: what it is called, what
/// shape it holds, and where it sits among the others. `body` is the whole of
/// a `text` section; every other kind holds entries. The vocabulary of kinds
/// is `lib/profile/shared/sections.ts` — the column is a plain string so a new
/// kind is a row in that table, not a migration.
model ProfileSection {
  id        String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String                @map("user_id")
  title     String
  kind      String
  body      String?
  position  Int                   @default(0)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   ProfileSectionEntry[]

  @@index([userId, position])
  @@map("profile_sections")
}

/// One row of a section. Every kind reads the columns it uses and leaves the
/// rest null — the kind says which those are, never the row. A row may point
/// at a space its owner belongs to, which draws that space and opens it; the
/// row keeps its own title, so it still reads once the space is gone.
model ProfileSectionEntry {
  id          String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  sectionId   String         @map("section_id")
  title       String?
  subtitle    String?
  description String?
  url         String?
  /// 'YYYY' — a year, not a date.
  startYear   String?        @map("start_year")
  endYear     String?        @map("end_year")
  imageUrl    String?        @map("image_url")
  spaceId     String?        @map("space_id")
  position    Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  section     ProfileSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  space       Space?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([sectionId, position])
  @@map("profile_section_entries")
}
