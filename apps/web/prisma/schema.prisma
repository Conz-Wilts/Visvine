generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Community {
  id               String          @id
  name             String
  description      String?
  location         String?
  tags             String[]        @default([])
  memberCount      Int             @default(0) @map("member_count")
  dataFile         String?         @map("data_file")
  createdAt        DateTime        @default(now()) @map("created_at")
  imageUrl         String?         @map("image_url")
  nodeTypes        Json?           @default("[{\"icon\": \"👤\", \"name\": \"Person\", \"color\": \"#2563eb\", \"shape\": \"rectangle\"}, {\"icon\": \"🏢\", \"name\": \"Organization\", \"color\": \"#9333ea\", \"shape\": \"hexagon\"}, {\"icon\": \"📅\", \"name\": \"Event\", \"color\": \"#ef4444\", \"shape\": \"rectangle\"}, {\"icon\": \"👥\", \"name\": \"Group\", \"color\": \"#0ea5e9\", \"shape\": \"rectangle\"}]") @map("node_types")
  emoji            String?
  communityAliases Json?           @default("[]") @map("community_aliases")
  country          String?
  crmSettings      Json            @default("{}") @map("crm_settings")
  designConfig     Json            @default("{}") @map("design_config")
  links            Link[]
  nodes            Node[]
  userCommunities  UserCommunity[]
  graphLayout      GraphLayout?

  @@map("communities")
}

/// Persisted force-directed graph layout for a community's directory graph view.
/// Stored once per community (a shared canonical layout) so reopening the graph
/// restores saved node positions + camera transform instead of re-running the
/// expensive simulation from scratch.
model GraphLayout {
  communityId String    @id @map("community_id")
  hash        String // signature of node ids + link count; layout is reused only while this matches
  transform   Json      @default("{}") // { x, y, k } camera transform
  positions   Json      @default("{}") // { [nodeId]: { x, y } }
  updatedAt   DateTime  @updatedAt @map("updated_at")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("graph_layouts")
}

model Node {
  id                    String                 @id
  type                  String
  name                  String
  subtitle              String?
  location              String?
  url                   String?
  tags                  String[]               @default([])
  imageUrl              String?                @map("image_url")
  metadata              Json                   @default("{}")
  communityId           String?                @map("community_id")
  embedding             Unsupported("vector")?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  alias                 String?
  attendees             Attendee[]             @relation("EventNode")
  attendeePerson        Attendee[]             @relation("PersonNode")
  communityColumnValues CommunityColumnValue[]
  linksAsSource         Link[]                 @relation("SourceNode")
  linksAsTarget         Link[]                 @relation("TargetNode")
  community             Community?             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  privateColumnValues   PrivateColumnValue[]

  @@index([communityId])
  @@index([type])
  @@index([communityId, type])
  @@map("nodes")
}

model Link {
  id           Int        @id @default(autoincrement())
  sourceId     String     @map("source_id")
  targetId     String     @map("target_id")
  relationship String
  since        String?
  metadata     Json       @default("{}")
  communityId  String?    @map("community_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  community    Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  source       Node       @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Node       @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@index([communityId])
  @@map("links")
}

model Attendee {
  id          String    @id
  eventId     String    @map("event_id")
  personId    String?   @map("person_id")
  email       String?
  linkedinUrl String?   @map("linkedin_url")
  companyName String?   @map("company_name")
  roleTitle   String?   @map("role_title")
  answers     Json      @default("{}")
  status      String    @default("registered")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  checkinAt   DateTime? @map("checkin_at")
  event       Node      @relation("EventNode", fields: [eventId], references: [id], onDelete: Cascade)
  person      Node?     @relation("PersonNode", fields: [personId], references: [id])

  @@index([eventId])
  @@index([personId])
  @@index([email])
  @@map("attendees")
}

model User {
  id                      String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false) @map("email_verified")
  image                   String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  claimNonce              String?                  @unique @map("claim_nonce")
  googleId                String?                  @unique @map("google_id")
  isActive                Boolean                  @default(true) @map("is_active")
  oauthProvider           String?                  @map("oauth_provider")
  publicMeta              Json                     @default("{}") @map("public_meta")
  columnRequestsSubmitted CommunityColumnRequest[] @relation("ColumnRequestRequester")
  columnRequestsReviewed  CommunityColumnRequest[] @relation("ColumnRequestReviewer")
  communityColumnValues   CommunityColumnValue[]
  conversationMemberships ConversationMember[]
  conversationsCreated    Conversation[]           @relation("ConversationCreator")
  messagesSent            Message[]                @relation("MessageSender")
  person                  Person?
  privateColumnValues     PrivateColumnValue[]
  privateColumns          PrivateColumn[]
  membersAdded            UserCommunity[]          @relation("AddedByRelation")
  userCommunities         UserCommunity[]          @relation("MemberOf")
  posts                   Post[]                   @relation("PostAuthor")
  postComments            PostComment[]            @relation("CommentAuthor")
  postLikes               PostLike[]               @relation("PostLiker")
  postReactions           PostReaction[]           @relation("PostReactor")
  postCommentReactions    PostCommentReaction[]    @relation("CommentReactor")
  messageReactions        MessageReaction[]        @relation("ReactionAuthor")
  messageDeliveries       MessageDelivery[]
  messageStars            MessageStar[]
  pushSubscriptions       PushSubscription[]
  blocksInitiated         UserBlock[]              @relation("Blocker")
  blocksReceived          UserBlock[]              @relation("Blocked")
  pollVotes               PollVote[]
  scheduledMessages       ScheduledMessage[]
  valueSharesSubmitted    ValueShareRequest[]      @relation("ValueShareRequester")
  valueSharesReviewed     ValueShareRequest[]      @relation("ValueShareReviewer")

  @@index([email])
  @@index([email], map: "idx_user_email")
  @@map("user")
}

model UserCommunity {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  communityId String    @map("community_id")
  role        String    @default("member")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  addedBy     String?   @map("added_by")
  privateMeta Json      @default("{}") @map("private_meta")
  addedByUser User?     @relation("AddedByRelation", fields: [addedBy], references: [id])
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation("MemberOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@index([communityId, role])
  @@index([communityId], map: "idx_user_communities_community_id")
  @@index([userId], map: "idx_user_communities_user_id")
  @@map("user_communities")
}

model PrivateColumn {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String               @map("user_id")
  communityId String?              @map("community_id")
  columnKey   String               @map("column_key")
  columnName  String               @map("column_name")
  columnType  String               @map("column_type")
  options     Json?
  position    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  nodeType    String?              @map("node_type")
  isGlobal    Boolean              @default(true) @map("is_global")
  values      PrivateColumnValue[]
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, columnKey])
  @@index([userId])
  @@map("private_columns")
}

model PrivateColumnValue {
  id        String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String        @map("user_id")
  nodeId    String        @map("node_id")
  columnId  String        @map("column_id")
  value     String?
  updatedAt DateTime      @updatedAt @map("updated_at")
  column    PrivateColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  node      Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId, columnId])
  @@index([userId, nodeId])
  @@index([columnId])
  @@map("private_column_values")
}

model CommunityColumnRequest {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId     String           @map("community_id")
  requesterId     String           @map("requester_id")
  columnKey       String           @map("column_key")
  columnName      String           @map("column_name")
  columnType      String           @map("column_type")
  options         Json?
  description     String?
  status          String           @default("pending")
  reviewerId      String?          @map("reviewer_id")
  reviewerNote    String?          @map("reviewer_note")
  createdAt       DateTime         @default(now()) @map("created_at")
  reviewedAt      DateTime?        @map("reviewed_at")
  nodeType        String?          @map("node_type")
  requester       User             @relation("ColumnRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer        User?            @relation("ColumnRequestReviewer", fields: [reviewerId], references: [id])
  communityColumn CommunityColumn? @relation("CreatedFromRequest")

  @@index([communityId, status])
  @@index([requesterId])
  @@map("community_column_requests")
}

model CommunityColumn {
  id                   String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId          String                  @map("community_id")
  columnKey            String                  @map("column_key")
  columnName           String                  @map("column_name")
  columnType           String                  @map("column_type")
  options              Json?
  position             Int                     @default(0)
  createdFromRequestId String?                 @unique @map("created_from_request_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  nodeType             String?                 @map("node_type")
  values               CommunityColumnValue[]
  createdFromRequest   CommunityColumnRequest? @relation("CreatedFromRequest", fields: [createdFromRequestId], references: [id])

  @@unique([communityId, columnKey])
  @@index([communityId])
  @@map("community_columns")
}

model CommunityColumnValue {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId     String          @map("community_id")
  nodeId          String          @map("node_id")
  columnKey       String          @map("column_key")
  columnId        String          @map("column_id")
  value           String?
  contributedById String?         @map("contributed_by_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  column          CommunityColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  contributedBy   User?           @relation(fields: [contributedById], references: [id])
  node            Node            @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([communityId, nodeId, columnKey])
  @@index([communityId, nodeId])
  @@index([columnId])
  @@map("community_column_values")
}

model ValueShareRequest {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  requesterId  String    @map("requester_id")
  communityId  String    @map("community_id")
  nodeId       String    @map("node_id")
  columnKey    String    @map("column_key")
  columnName   String    @map("column_name")
  columnType   String    @map("column_type")
  value        String?
  status       String    @default("pending")
  reviewerId   String?   @map("reviewer_id")
  reviewerNote String?   @map("reviewer_note")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  requester    User      @relation("ValueShareRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("ValueShareReviewer", fields: [reviewerId], references: [id])

  @@index([communityId, status])
  @@index([requesterId])
  @@map("value_share_requests")
}

model Conversation {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  type        ConversationType     @default(DM)
  name        String?
  avatarUrl   String?              @map("avatar_url")
  dmKey       String?              @unique @map("dm_key")
  createdById String               @map("created_by_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  members     ConversationMember[]
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([type])
  @@index([updatedAt])
  @@map("conversations")
}

model ConversationMember {
  id             String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String                 @map("conversation_id")
  userId         String                 @map("user_id")
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now()) @map("joined_at")
  lastReadAt     DateTime?              @map("last_read_at")
  mutedUntil     DateTime?              @map("muted_until")
  archivedAt     DateTime?              @map("archived_at")
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([conversationId, lastReadAt])
  @@map("conversation_members")
}

model Message {
  id              String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId  String               @map("conversation_id")
  senderId        String               @map("sender_id")
  text            String
  attachmentUrl   String?              @map("attachment_url")
  editedAt        DateTime?            @map("edited_at")
  deletedAt       DateTime?            @map("deleted_at")
  replyToId       String?              @map("reply_to_id")
  forwardedFromId String?              @map("forwarded_from_id")
  threadRootId    String?              @map("thread_root_id")
  pinnedAt        DateTime?            @map("pinned_at")
  expiresAt       DateTime?            @map("expires_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  conversation    Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         Message?             @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]            @relation("MessageReplies")
  forwardedFrom   Message?             @relation("MessageForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards        Message[]            @relation("MessageForwards")
  threadRoot      Message?             @relation("MessageThread", fields: [threadRootId], references: [id], onDelete: Cascade)
  threadReplies   Message[]            @relation("MessageThread")
  images          MessageImage[]
  mentions        MessageMention[]
  reactions       MessageReaction[]
  linkPreviews    MessageLinkPreview[]
  deliveries      MessageDelivery[]
  attachments     MessageAttachment[]
  stars           MessageStar[]
  poll            Poll?

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@index([conversationId, pinnedAt])
  @@index([threadRootId])
  @@index([expiresAt])
  @@map("messages")
}

model MessageImage {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  imageUrl  String   @map("image_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_images")
}

model MessageMention {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId       String   @map("message_id")
  mentionedUserId String?  @map("mentioned_user_id")
  mentionedNodeId String?  @map("mentioned_node_id")
  mentionType     String   @default("user") @map("mention_type")
  createdAt       DateTime @default(now()) @map("created_at")
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([mentionedUserId])
  @@index([mentionedNodeId])
  @@map("message_mentions")
}

model MessageReaction {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model LinkPreview {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  url         String               @unique
  title       String?
  description String?
  imageUrl    String?              @map("image_url")
  siteName    String?              @map("site_name")
  fetchedAt   DateTime             @default(now()) @map("fetched_at")
  messages    MessageLinkPreview[]

  @@map("link_previews")
}

model MessageLinkPreview {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId     String      @map("message_id")
  linkPreviewId String      @map("link_preview_id")
  message       Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  linkPreview   LinkPreview @relation(fields: [linkPreviewId], references: [id])

  @@index([messageId])
  @@map("message_link_previews")
}

model Person {
  id           String   @id
  userId       String?  @unique @map("user_id")
  name         String
  subtitle     String?
  bio          String?
  location     String?
  website      String?  @map("website")
  linkedinUrl  String?  @map("linkedin_url")
  twitterUrl   String?  @map("twitter_url")
  phone        String?
  pronouns     String?
  openToWork   Boolean  @default(false) @map("open_to_work")
  imageUrl     String?  @map("image_url")
  tags         String[] @default([])
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  hasOnboarded Boolean  @default(false) @map("has_onboarded")
  user         User?    @relation(fields: [userId], references: [id])

  @@map("persons")
}

model Resource {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId String            @map("community_id")
  name        String
  fileType    String            @map("file_type")
  fileUrl     String            @map("file_url")
  fileSize    Int?              @map("file_size")
  uploadedBy  String            @map("uploaded_by")
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at")
  changes     ResourceChange[]
  comments    ResourceComment[]

  @@index([communityId])
  @@map("resources")
}

model ResourceComment {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId String   @map("resource_id")
  cellRef    String?  @map("cell_ref")
  author     String
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([resourceId, cellRef])
  @@map("resource_comments")
}

model ResourceChange {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId    String    @map("resource_id")
  cellRef       String    @map("cell_ref")
  originalValue String?   @map("original_value")
  proposedValue String    @map("proposed_value")
  reason        String?
  proposedBy    String    @map("proposed_by")
  status        String    @default("pending")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  resource      Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([resourceId, status])
  @@map("resource_changes")
}

model AuditLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId     String   @map("actor_id")
  communityId String?  @map("community_id")
  targetId    String?  @map("target_id")
  action      String
  diff        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([communityId])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_log")
}

model Post {
  id          String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId String         @map("community_id")
  authorId    String         @map("author_id")
  content     String
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  images      PostImage[]
  comments    PostComment[]
  likes       PostLike[]
  reactions   PostReaction[]
  mentions    PostMention[]
  author      User           @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([authorId])
  @@map("posts")
}

model PostImage {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId    String   @map("post_id")
  imageUrl  String   @map("image_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_images")
}

model PostComment {
  id        String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId    String                @map("post_id")
  authorId  String                @map("author_id")
  parentId  String?               @map("parent_id")
  content   String
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")
  post      Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User                  @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?          @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[]         @relation("CommentThread")
  mentions  PostMention[]
  reactions PostCommentReaction[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@map("post_comments")
}

model PostLike {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("PostLiker", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model PostMention {
  id              String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId          String?      @map("post_id")
  commentId       String?      @map("comment_id")
  mentionedUserId String       @map("mentioned_user_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  post            Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment         PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([commentId])
  @@index([mentionedUserId])
  @@map("post_mentions")
}

model PostReaction {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("PostReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@map("post_reactions")
}

model PostCommentReaction {
  id        String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  commentId String      @map("comment_id")
  userId    String      @map("user_id")
  emoji     String
  createdAt DateTime    @default(now()) @map("created_at")
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation("CommentReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("post_comment_reactions")
}

enum ConversationType {
  DM
  GROUP
}

enum ConversationMemberRole {
  MEMBER
  ADMIN
}

model MessageDelivery {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId   String    @map("message_id")
  userId      String    @map("user_id")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@index([messageId])
  @@map("message_deliveries")
}

model MessageAttachment {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId  String   @map("message_id")
  url        String
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  name       String
  kind       String   @default("file") // file | audio | video
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model MessageStar {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
  @@map("message_stars")
}

model UserBlock {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model ScheduledMessage {
  id             String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  text           String
  payload        Json      @default("{}")
  scheduledFor   DateTime  @map("scheduled_for")
  sentAt         DateTime? @map("sent_at")
  canceledAt     DateTime? @map("canceled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  sender         User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, sentAt])
  @@index([senderId])
  @@map("scheduled_messages")
}

model Poll {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String     @unique @map("message_id")
  question  String
  options   Json // [{id, text}]
  multi     Boolean    @default(false)
  closesAt  DateTime?  @map("closes_at")
  createdAt DateTime   @default(now()) @map("created_at")
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@map("polls")
}

model PollVote {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  pollId    String   @map("poll_id")
  userId    String   @map("user_id")
  optionId  String   @map("option_id")
  createdAt DateTime @default(now()) @map("created_at")
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@map("poll_votes")
}
