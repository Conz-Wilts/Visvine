}

model MessageImage {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  imageUrl  String   @map("image_url")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_images")
}

/// A Drive file a message carries. The bytes are one `Resource`, as Slack keeps
/// one File a message references, so the same file is listed in Resources.
model MessageFile {
  messageId  String   @map("message_id")
  resourceId String   @map("resource_id")
  position   Int      @default(0)
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([messageId, resourceId])
  @@index([resourceId])
  @@map("message_files")
}

model MessageMention {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId       String   @map("message_id")
  mentionedUserId String?  @map("mentioned_user_id")
  mentionedNodeId String?  @map("mentioned_node_id")
  mentionType     String   @default("user") @map("mention_type")
  createdAt       DateTime @default(now()) @map("created_at")
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([mentionedUserId])
  @@index([mentionedNodeId])
  @@map("message_mentions")
}

model MessageReaction {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation("ReactionAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
