generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Community {
  id               String          @id
  name             String
  description      String?
  location         String?
  tags             String[]        @default([])
  memberCount      Int             @default(0) @map("member_count")
  dataFile         String?         @map("data_file")
  createdAt        DateTime        @default(now()) @map("created_at")
  imageUrl         String?         @map("image_url")
  nodeTypes        Json?           @default("[{\"icon\": \"👤\", \"name\": \"Person\", \"color\": \"#2563eb\", \"shape\": \"rectangle\"}, {\"icon\": \"🏢\", \"name\": \"Organization\", \"color\": \"#9333ea\", \"shape\": \"hexagon\"}, {\"icon\": \"📅\", \"name\": \"Event\", \"color\": \"#ef4444\", \"shape\": \"rectangle\"}, {\"icon\": \"👥\", \"name\": \"Group\", \"color\": \"#0ea5e9\", \"shape\": \"rectangle\"}]") @map("node_types")
  emoji            String?
  communityAliases Json?           @default("[]") @map("community_aliases")
  linkTypes        Json?           @default("[{\"name\": \"Related\", \"color\": \"#94a3b8\", \"directed\": false}, {\"name\": \"Knows\", \"color\": \"#2563eb\", \"directed\": false}, {\"name\": \"Works at\", \"color\": \"#9333ea\", \"directed\": true}, {\"name\": \"Founded\", \"color\": \"#16a34a\", \"directed\": true}, {\"name\": \"Invested in\", \"color\": \"#f59e0b\", \"directed\": true}, {\"name\": \"Member of\", \"color\": \"#0ea5e9\", \"directed\": true}, {\"name\": \"Partner\", \"color\": \"#ec4899\", \"directed\": false}, {\"name\": \"Mentors\", \"color\": \"#14b8a6\", \"directed\": true}, {\"name\": \"Attended\", \"color\": \"#ef4444\", \"directed\": true, \"system\": true}, {\"name\": \"Hosting\", \"color\": \"#ef4444\", \"directed\": true, \"system\": true}, {\"name\": \"Introduced\", \"color\": \"#06b6d4\", \"directed\": false, \"system\": true}]") @map("link_types")
  country          String?
  crmSettings      Json            @default("{}") @map("crm_settings")
  designConfig     Json            @default("{}") @map("design_config")
  featureConfig    Json            @default("{}") @map("feature_config")
  // Set = a private, single-member "personal space" owned by this user (created at
  // onboarding to host their personal context notes). Null = a normal community.
  // Filtered out of Discover / other users' community lists.
  personalOwnerId  String?         @map("personal_owner_id")
  links            Link[]
  nodes            Node[]
  userCommunities  UserCommunity[]
  graphLayout      GraphLayout?
  notes            CommunityNote[]
  noteFolders      CommunityNoteFolder[]

  @@index([personalOwnerId])
  @@map("communities")
}

/// A markdown note in a community's notes/knowledge surface. Notes live in a
/// "brain" identified by (communityId, ownerKey): ownerKey "shared" = the
/// community-wide brain every member sees; any other value is a userId = that
/// user's personal brain scoped to this community. `path` is the brain-relative
/// POSIX path ("portfolio/canva.md") and doubles as the link-resolution identity,
/// so the pure index/graph/backlink pipeline (lib/notes/shared) treats a row exactly
/// like a file on disk. `content` (full markdown incl. YAML frontmatter) is the
/// source of truth. Soft-deleted notes (deletedAt set) are the trash.
model CommunityNote {
  id          String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId String                  @map("community_id")
  ownerKey    String                  @map("owner_key") // 'shared' = community brain; else a userId = personal brain
  path        String // brain-relative POSIX path, e.g. "portfolio/canva.md"
  content     String // full markdown incl. frontmatter (source of truth)
  pinned      Boolean                 @default(false)
  createdBy   String                  @map("created_by")
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  deletedAt   DateTime?               @map("deleted_at") // soft-delete = trash; null = live
  deletedPath String?                 @map("deleted_path") // original path while trashed
  community   Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  revisions   CommunityNoteRevision[]

  @@unique([communityId, ownerKey, path], name: "note_identity")
  @@index([communityId, ownerKey, deletedAt])
  @@map("community_notes")
}

/// Append-only revision snapshots for a CommunityNote (newest by `at`). Mirrors
/// the .history sidecar of the source app: a baseline is seeded on first edit and
/// every save records a full snapshot, capped/coalesced in lib/notes/store.ts.
model CommunityNoteRevision {
  id          String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  noteId      String        @map("note_id")
  at          DateTime      @default(now())
  editor      String // display name of who saved it (from the session)
  editorEmail String?       @map("editor_email")
  origin      String        @default("edit") // edit | ai-refactor | restore | baseline
  model       String? // LLM model name when origin = ai-refactor
  content     String // full snapshot (frontmatter + body) at this save
  note        CommunityNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, at])
  @@map("community_note_revisions")
}

/// Explicitly-created folders for a brain. Notes already imply their ancestor
/// folders, but this table lets empty folders exist and be renamed; the tree
/// builder grafts these in alongside note-derived folders.
model CommunityNoteFolder {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId String    @map("community_id")
  ownerKey    String    @map("owner_key")
  path        String
  createdAt   DateTime  @default(now()) @map("created_at")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, ownerKey, path], name: "folder_identity")
  @@index([communityId, ownerKey])
  @@map("community_note_folders")
}

/// Persisted force-directed graph layout for a community's directory graph view.
/// Stored once per community (a shared canonical layout) so reopening the graph
/// restores saved node positions + camera transform instead of re-running the
/// expensive simulation from scratch.
model GraphLayout {
  communityId String    @id @map("community_id")
  hash        String // signature of node ids + link count; layout is reused only while this matches
  transform   Json      @default("{}") // { x, y, k } camera transform
  positions   Json      @default("{}") // { [nodeId]: { x, y } }
  updatedAt   DateTime  @updatedAt @map("updated_at")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("graph_layouts")
}

model Node {
  id                    String                 @id
  type                  String
  name                  String
  subtitle              String?
  location              String?
  url                   String?
  tags                  String[]               @default([])
  imageUrl              String?                @map("image_url")
  metadata              Json                   @default("{}")
  communityId           String?                @map("community_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  alias                 String?
  // Canonical cross-community identity this node represents (people/orgs). Nullable:
  // legacy rows and non-person/org types may have none. Set by lib/identity/resolve.
  identityId            String?                @map("identity_id")
  identity              Identity?              @relation(fields: [identityId], references: [id], onDelete: SetNull)
  attendees             Attendee[]             @relation("EventNode")
  attendeePerson        Attendee[]             @relation("PersonNode")
  communityColumnValues CommunityColumnValue[]
  linksAsSource         Link[]                 @relation("SourceNode")
  linksAsTarget         Link[]                 @relation("TargetNode")
  community             Community?             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  privateColumnValues   PrivateColumnValue[]

  @@index([communityId])
  @@index([type])
  @@index([communityId, type])
  @@index([identityId])
  @@map("nodes")
}

model Link {
  id           Int        @id @default(autoincrement())
  sourceId     String     @map("source_id")
  targetId     String     @map("target_id")
  relationship String
  since        String?
  metadata     Json       @default("{}")
  communityId  String?    @map("community_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  // Provenance + dedup (see docs/link-management-design.md). `pairKey` is the
  // normalized "minId|maxId" of the two endpoints so A->B and B->A dedup as one
  // edge; always computed by lib/graph/links.ts upsertLink, never raw-written blank.
  origin       String     @default("manual") @map("origin") // manual | event_attendance | event_hosting | intro | import
  originRef    String?    @map("origin_ref") // Attendee.id / IntroRequest.id / event node id — for symmetric auto-undo
  createdBy    String?    @map("created_by") // userId for manual links; null for system/auto
  updatedAt    DateTime   @updatedAt @default(now()) @map("updated_at")
  pairKey      String     @map("pair_key")
  community    Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  source       Node       @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target       Node       @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([communityId, pairKey, relationship], name: "link_identity") // dedup; origin deliberately NOT in the key
  @@index([sourceId])
  @@index([targetId])
  @@index([communityId])
  @@index([pairKey])
  @@map("links")
}

model Attendee {
  id              String    @id
  eventId         String    @map("event_id")
  personId        String?   @map("person_id")
  name            String? // typed guest name (loginless RSVP; no Person node required)
  email           String?
  linkedinUrl     String?   @map("linkedin_url")
  companyName     String?   @map("company_name")
  roleTitle       String?   @map("role_title")
  answers         Json      @default("{}")
  // Operational lifecycle: going | waitlisted | pending | checked_in | no_show | cancelled | invited.
  // Legacy rows may still hold 'registered' (normalized to 'going' on read — see eventUtils.normalizeStatus).
  status          String    @default("going")
  // Guest's intent, separate from the operational status: going | maybe | declined.
  response        String?
  plusOnes        Int       @default(0) @map("plus_ones")
  plusOneNames    String[]  @default([]) @map("plus_one_names")
  invitedBy       String?   @map("invited_by") // userId/personId who invited/added them
  remindersSentAt Json      @default("{}") @map("reminders_sent_at") // { "24h": iso, "1h": iso } dedupe
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  checkinAt       DateTime? @map("checkin_at")
  event           Node      @relation("EventNode", fields: [eventId], references: [id], onDelete: Cascade)
  person          Node?     @relation("PersonNode", fields: [personId], references: [id])

  @@unique([eventId, email]) // dedupe RSVPs by email (NULL emails remain distinct in Postgres)
  @@index([eventId])
  @@index([eventId, status])
  @@index([personId])
  @@index([email])
  @@map("attendees")
}

model User {
  id                      String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false) @map("email_verified")
  image                   String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  claimNonce              String?                  @unique @map("claim_nonce")
  googleId                String?                  @unique @map("google_id")
  passwordHash            String?                  @map("password_hash")
  isActive                Boolean                  @default(true) @map("is_active")
  oauthProvider           String?                  @map("oauth_provider")
  publicMeta              Json                     @default("{}") @map("public_meta")
  columnRequestsSubmitted CommunityColumnRequest[] @relation("ColumnRequestRequester")
  columnRequestsReviewed  CommunityColumnRequest[] @relation("ColumnRequestReviewer")
  communityColumnValues   CommunityColumnValue[]
  person                  Person?
  privateColumnValues     PrivateColumnValue[]
  privateColumns          PrivateColumn[]
  membersAdded            UserCommunity[]          @relation("AddedByRelation")
  userCommunities         UserCommunity[]          @relation("MemberOf")
  valueSharesSubmitted    ValueShareRequest[]      @relation("ValueShareRequester")
  valueSharesReviewed     ValueShareRequest[]      @relation("ValueShareReviewer")
  blogPosts               BlogPost[]               @relation("BlogPostAuthor")
  blogComments            BlogComment[]            @relation("BlogCommentAuthor")
  blogCommentReactions    BlogCommentReaction[]    @relation("BlogCommentReactor")

  @@index([email])
  @@index([email], map: "idx_user_email")
  @@map("user")
}

model UserCommunity {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String    @map("user_id")
  communityId String    @map("community_id")
  role        String    @default("member")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  addedBy     String?   @map("added_by")
  privateMeta Json      @default("{}") @map("private_meta")
  addedByUser User?     @relation("AddedByRelation", fields: [addedBy], references: [id])
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation("MemberOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([userId])
  @@index([communityId])
  @@index([communityId, role])
  @@index([communityId], map: "idx_user_communities_community_id")
  @@index([userId], map: "idx_user_communities_user_id")
  @@map("user_communities")
}

model PrivateColumn {
  id          String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId      String               @map("user_id")
  communityId String?              @map("community_id")
  columnKey   String               @map("column_key")
  columnName  String               @map("column_name")
  columnType  String               @map("column_type")
  options     Json?
  position    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  nodeType    String?              @map("node_type")
  isGlobal    Boolean              @default(true) @map("is_global")
  values      PrivateColumnValue[]
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, columnKey])
  @@index([userId])
  @@map("private_columns")
}

model PrivateColumnValue {
  id        String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String        @map("user_id")
  nodeId    String        @map("node_id")
  columnId  String        @map("column_id")
  value     String?
  updatedAt DateTime      @updatedAt @map("updated_at")
  column    PrivateColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  node      Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId, columnId])
  @@index([userId, nodeId])
  @@index([columnId])
  @@map("private_column_values")
}

model CommunityColumnRequest {
  id              String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId     String           @map("community_id")
  requesterId     String           @map("requester_id")
  columnKey       String           @map("column_key")
  columnName      String           @map("column_name")
  columnType      String           @map("column_type")
  options         Json?
  description     String?
  status          String           @default("pending")
  reviewerId      String?          @map("reviewer_id")
  reviewerNote    String?          @map("reviewer_note")
  createdAt       DateTime         @default(now()) @map("created_at")
  reviewedAt      DateTime?        @map("reviewed_at")
  nodeType        String?          @map("node_type")
  requester       User             @relation("ColumnRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer        User?            @relation("ColumnRequestReviewer", fields: [reviewerId], references: [id])
  communityColumn CommunityColumn? @relation("CreatedFromRequest")

  @@index([communityId, status])
  @@index([requesterId])
  @@map("community_column_requests")
}

model CommunityColumn {
  id                   String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId          String                  @map("community_id")
  columnKey            String                  @map("column_key")
  columnName           String                  @map("column_name")
  columnType           String                  @map("column_type")
  options              Json?
  position             Int                     @default(0)
  createdFromRequestId String?                 @unique @map("created_from_request_id")
  createdAt            DateTime                @default(now()) @map("created_at")
  nodeType             String?                 @map("node_type")
  values               CommunityColumnValue[]
  createdFromRequest   CommunityColumnRequest? @relation("CreatedFromRequest", fields: [createdFromRequestId], references: [id])

  @@unique([communityId, columnKey])
  @@index([communityId])
  @@map("community_columns")
}

model CommunityColumnValue {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId     String          @map("community_id")
  nodeId          String          @map("node_id")
  columnKey       String          @map("column_key")
  columnId        String          @map("column_id")
  value           String?
  contributedById String?         @map("contributed_by_id")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  column          CommunityColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  contributedBy   User?           @relation(fields: [contributedById], references: [id])
  node            Node            @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([communityId, nodeId, columnKey])
  @@index([communityId, nodeId])
  @@index([columnId])
  @@map("community_column_values")
}

model ValueShareRequest {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  requesterId  String    @map("requester_id")
  communityId  String    @map("community_id")
  nodeId       String    @map("node_id")
  columnKey    String    @map("column_key")
  columnName   String    @map("column_name")
  columnType   String    @map("column_type")
  value        String?
  status       String    @default("pending")
  reviewerId   String?   @map("reviewer_id")
  reviewerNote String?   @map("reviewer_note")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  requester    User      @relation("ValueShareRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer     User?     @relation("ValueShareReviewer", fields: [reviewerId], references: [id])

  @@index([communityId, status])
  @@index([requesterId])
  @@map("value_share_requests")
}

model Person {
  id           String   @id
  userId       String?  @unique @map("user_id")
  name         String
  subtitle     String?
  bio          String?
  location     String?
  website      String?  @map("website")
  linkedinUrl  String?  @map("linkedin_url")
  twitterUrl   String?  @map("twitter_url")
  phone        String?
  pronouns     String?
  openToWork   Boolean  @default(false) @map("open_to_work")
  imageUrl     String?  @map("image_url")
  tags         String[] @default([])
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  hasOnboarded Boolean  @default(false) @map("has_onboarded")
  user         User?    @relation(fields: [userId], references: [id])

  @@map("persons")
}

/// Canonical, cross-community identity for a real person or organization.
/// Each community keeps its own private `Node` row; all nodes that represent the
/// same real person/org point to ONE Identity (Node.identityId). Communities never
/// share their per-node data — only identity-level facts live here (canonical name,
/// photo, strong identifiers). Resolution (lib/identity/resolve.ts) decides whether
/// a new node attaches to an existing identity or mints a new one. `userId` links the
/// identity to a registered User when claimed/verified (email/linkedin become
/// authoritative); kept as a plain unique scalar to avoid a relation on the large
/// User model. Strong identifiers are stored normalized and treated as effectively
/// unique per kind by the resolver/backfill (no DB partial-unique with db push).
model Identity {
  kind           String // 'person' | 'organization'
  canonicalName  String   @map("canonical_name")
  nameKey        String   @map("name_key") // normalized name, used for blocking
  imageUrl       String?  @map("image_url")
  email          String? // normalized lowercase (person)
  linkedinHandle String?  @map("linkedin_handle") // normalized "linkedin.com/in/x" (person)
  websiteDomain  String?  @map("website_domain") // normalized bare domain (org)
  metadata       Json     @default("{}") // survivorship signals: { company, location, ... }
  verified       Boolean  @default(false)
  userId         String?  @unique @map("user_id") // set when claimed by a registered User
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  nodes          Node[]

  @@index([kind, email])
  @@index([kind, linkedinHandle])
  @@index([kind, websiteDomain])
  @@index([kind, nameKey])
  @@map("identities")
}

/// Append-only audit trail of identity-resolution decisions, for transparency and
/// reversibility. Also records anti-matches: a `rejected` (or `split`) row for a
/// (nodeId, identityId) pair tells the resolver "these are NOT the same" so it never
/// re-suggests or re-auto-merges them. `actorUserId` is null for system decisions.
model IdentityResolution {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  nodeId      String   @map("node_id")
  identityId  String?  @map("identity_id") // candidate or chosen identity
  decision    String // auto_strong | auto_name_company | suggested | confirmed | rejected | split | merged
  confidence  Float    @default(0)
  reason      String // human-readable, e.g. "email match" | "name+company"
  actorUserId String?  @map("actor_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([nodeId])
  @@index([identityId])
  @@index([decision])
  @@map("identity_resolutions")
}

model Resource {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  communityId String            @map("community_id")
  name        String
  fileType    String            @map("file_type")
  fileUrl     String            @map("file_url")
  fileSize    Int?              @map("file_size")
  uploadedBy  String            @map("uploaded_by")
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @map("created_at")
  changes     ResourceChange[]
  comments    ResourceComment[]

  @@index([communityId])
  @@map("resources")
}

model ResourceComment {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId String   @map("resource_id")
  cellRef    String?  @map("cell_ref")
  author     String
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([resourceId, cellRef])
  @@map("resource_comments")
}

model ResourceChange {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  resourceId    String    @map("resource_id")
  cellRef       String    @map("cell_ref")
  originalValue String?   @map("original_value")
  proposedValue String    @map("proposed_value")
  reason        String?
  proposedBy    String    @map("proposed_by")
  status        String    @default("pending")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  resource      Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([resourceId, status])
  @@map("resource_changes")
}

model AuditLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  actorId     String   @map("actor_id")
  communityId String?  @map("community_id")
  targetId    String?  @map("target_id")
  action      String
  diff        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([communityId])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_log")
}


// ─── Marketing / launch surfaces (global, no communityId) ───

model WaitlistEntry {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  email     String   @unique
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  linkedin  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("waitlist_entries")
}

/// Blog post for the marketing site (renamed from launch-site `Post` to avoid
/// colliding with the community social-feed `Post` model above). `content` is a
/// TipTap JSON document.
model BlogPost {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug        String    @unique
  number      Int       @unique @default(0)
  title       String
  excerpt     String?
  content     Json      @default("{}")
  coverImage  String?   @map("cover_image")
  authorId    String?   @map("author_id")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  author      User?         @relation("BlogPostAuthor", fields: [authorId], references: [id])
  comments    BlogComment[]

  @@index([published, publishedAt])
  @@map("blog_posts")
}

model BlogComment {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  postId    String   @map("post_id")
  authorId  String?  @map("author_id")
  guestName String?  @map("guest_name")
  parentId  String?  @map("parent_id")
  content   String
  isPrivate Boolean  @default(false) @map("is_private")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post      BlogPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User?                 @relation("BlogCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    BlogComment?          @relation("BlogCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   BlogComment[]         @relation("BlogCommentThread")
  reactions BlogCommentReaction[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([postId, isPrivate, createdAt])
  @@map("blog_comments")
}

model BlogCommentReaction {
  id        String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  commentId String      @map("comment_id")
  userId    String      @map("user_id")
  emoji     String
  createdAt DateTime    @default(now()) @map("created_at")

  comment   BlogComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User        @relation("BlogCommentReactor", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("blog_comment_reactions")
}

// ─── MCP OAuth 2.1 authorization server (self-hosted; see docs/MCP.md) ───

/// A Dynamically-Registered (RFC 7591) MCP/OAuth client. Public clients (PKCE),
/// no client secret. `redirectUris` is the allowlist enforced at /authorize.
model OAuthClient {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  clientId     String   @unique @map("client_id")
  clientName   String?  @map("client_name")
  redirectUris String[] @default([]) @map("redirect_uris")
  scope        String? // space-delimited scopes the client may request
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("oauth_clients")
}

/// Short-lived, single-use authorization code (PKCE). Bound to the user that
/// approved consent, the requested scope, and the client's redirect_uri.
model OAuthAuthCode {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                String    @unique
  clientId            String    @map("client_id")
  userId              String    @map("user_id")
  redirectUri         String    @map("redirect_uri")
  scope               String
  codeChallenge       String    @map("code_challenge")
  codeChallengeMethod String    @default("S256") @map("code_challenge_method")
  expiresAt           DateTime  @map("expires_at")
  consumedAt          DateTime? @map("consumed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_auth_codes")
}

/// Rotating refresh token (stored as a SHA-256 hash, never plaintext).
model OAuthRefreshToken {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  tokenHash String    @unique @map("token_hash")
  clientId  String    @map("client_id")
  userId    String    @map("user_id")
  scope     String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("oauth_refresh_tokens")
}
