# ─── Production / Cloud SQL template ───────────────────────────────────────
# Copy to apps/web/.env when you want the local Next.js server to talk to the
# real Cloud SQL Postgres via the Cloud SQL Auth Proxy. Safe to commit-share —
# all real secret values must be filled in locally and never committed.
#
# Pair this with `pnpm db:proxy:cloud` (NOT `pnpm dev`, which boots the local
# docker Postgres on the same port). See RUN.md for the full switch procedure.

NODE_ENV=production

# Dev-auth bypass MUST be off when pointing at prod data. The /dev/login and
# /api/dev/* routes are also baked out at build time when NODE_ENV=production,
# so this is belt-and-braces.
ENABLE_DEV_AUTH=false

# ─── Database (via Cloud SQL Auth Proxy on 127.0.0.1:5432) ─────────────────
# The proxy authenticates with your gcloud ADC identity and forwards to the
# instance named below. Use the prod DB user/password from Secret Manager.
CLOUD_SQL_CONNECTION_NAME=your-gcp-project:your-region:your-instance
DATABASE_URL=postgresql://PROD_DB_USER:PROD_DB_PASSWORD@127.0.0.1:5432/visvine

# Alternatively use discrete parts (lib/prisma.ts honours these if DATABASE_URL
# is not set). Pick one form and stick with it.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=visvine

# ─── Auth ──────────────────────────────────────────────────────────────────
# MUST match whatever value production was deployed with — otherwise existing
# user sessions won't verify. Pull from Secret Manager; do not regenerate.
AUTH_SECRET=

# Comma-separated emails treated as super admin in production.
SUPER_ADMIN_EMAILS=

# ─── App ───────────────────────────────────────────────────────────────────
# The public origin the app thinks it lives at. For local prod-DB debugging
# this is still http://localhost:3000; for an actual prod deploy use the real
# domain so OAuth redirects line up.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Google OAuth ──────────────────────────────────────────────────────────
# Required for real sign-in. Both web and google-mobile callbacks read these.
# Make sure NEXT_PUBLIC_APP_URL/api/auth/callback/google is in the OAuth
# client's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Cloud Storage ──────────────────────────────────────────────────
# Production media + resource buckets. Service-account credentials below are
# used by lib/gcs.ts when running outside GCP (e.g. your laptop). Inside GCP
# (Cloud Run, GCE, etc.) prefer the runtime's attached service account and
# leave CLIENT_EMAIL/PRIVATE_KEY unset.
GCS_PROJECT_ID=
GCS_MEDIA_BUCKET=
GCS_RESOURCES_BUCKET=
GCS_CDN_BASE_URL=
GCS_CDN_HOSTNAME=
GCS_CLIENT_EMAIL=
# Paste the JSON private key with literal \n escapes; lib/gcs.ts un-escapes.
GCS_PRIVATE_KEY=

# ─── OpenAI (semantic search + query parsing) ──────────────────────────────
OPENAI_API_KEY=

# ─── Web Push (optional) ───────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@visvine.com

# ─── Google Maps (optional, used by event location picker) ─────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
