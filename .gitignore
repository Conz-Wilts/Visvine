# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage

# next.js
**/.next/
**/.next-verify/
**/out/
**/.expo/
**/.expo-shared/

# production
**/build

# misc
.DS_Store
Thumbs.db
# Claude Code's config is per developer, not per project — how the agent runs
# on someone's machine says nothing about how this app is built. Un-ignore a
# specific file here only if the team ever needs to SHARE one (a project hook
# and the settings entry registering it).
.claude/
CLAUDE.md
.idea/
*.swp
*.swo
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.logs/

# env files (can opt-in for committing if needed)
.env*

# Local storage driver (STORAGE_DRIVER=local): the buckets as folders
apps/web/.storage/
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# vercel
.vercel

# Playwright MCP browser-automation snapshots (scratch output)
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

**/lib/generated/prisma

# uploaded images
apps/web/public/uploads/
apps/web/public/images/nodes/
# Built by scripts/build-tool-vendor.ts on every `pnpm build` — the Tool frame's
# vendor ESM (React + @visvine/tool-kit), a build artifact, never a source file.
apps/web/public/tool-runtime/

# local credential docs (never commit)
docs/*.credentials.md

# migration files
supabase_data_dump.sql
*.dump.sql
*.local.sql

# nested/scratch repos (not submodules)
/blackbird-brain/

# Local dev fixtures (pg_dump output before/after GCS round-trip).
tmp/
*.dump

# stray root screenshots
/*.png

# build output (desktop: electron-builder; web: esbuild vendor bundles)
**/dist/
**/release/
