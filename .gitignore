# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage

# next.js
**/.next/
**/out/
**/.expo/
**/.expo-shared/

# production
**/build

# misc
.DS_Store
Thumbs.db
# Keep .claude local by default, but share project hooks + their config with the team.
# (.claude/.cache runtime markers and .claude/settings.local.json stay ignored.)
.claude/*
!.claude/settings.json
!.claude/hooks/
CLAUDE.md
.idea/
*.swp
*.swo
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# vercel
.vercel

# Playwright MCP browser-automation snapshots (scratch output)
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

**/lib/generated/prisma

# uploaded images
apps/web/public/uploads/
apps/web/public/images/nodes/

# local credential docs (never commit)
docs/*.credentials.md

# migration files
supabase_data_dump.sql
*.dump.sql
*.local.sql

# nested/scratch repos (not submodules)
/blackbird-brain/

# Local dev fixtures (pg_dump output before/after GCS round-trip).
# See docs/SETUP.md §6.
tmp/fixtures/
*.dump
