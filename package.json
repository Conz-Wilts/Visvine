{
  "name": "visvine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "pnpm install && docker compose up -d --wait && pnpm prisma:generate && pnpm db:migrate && pnpm db:seed",
    "dev": "docker compose up -d --wait && pnpm --filter @visvine/web dev",
    "dev:cloud": "concurrently -n proxy,web -c blue,green -k \"pnpm db:proxy:cloud\" \"pnpm --filter @visvine/web dev\"",
    "build": "pnpm --filter @visvine/web build",
    "start": "pnpm --filter @visvine/web start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @visvine/web test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker exec -it visvine-postgres psql -U postgres -d visvine",
    "db:migrate": "pnpm --filter @visvine/web db:push",
    "db:seed": "pnpm --filter @visvine/web db:seed",
    "db:reset": "node scripts/db-reset.mjs",
    "db:fresh": "pnpm --filter @visvine/web db:fresh",
    "prisma:generate": "pnpm --filter @visvine/web prisma:generate",
    "prisma:studio": "pnpm --filter @visvine/web prisma:studio",
    "mobile:dev": "pnpm --filter @visvine/mobile start",
    "mobile:start": "pnpm --filter @visvine/mobile start",
    "mobile:android": "pnpm --filter @visvine/mobile android",
    "mobile:ios": "pnpm --filter @visvine/mobile ios",
    "db:proxy:cloud": "bash scripts/start-cloud-sql-proxy.sh",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
