{
  "space": {
    "$type": "dimension",
    "$description": "Tailwind's step names, so `p-4` on the web and `VVSpace.x4` on a phone are the same 16. One step is 4px.",
    "0":   { "$value": "0px" },
    "px":  { "$value": "1px" },
    "0-5": { "$value": "2px" },
    "1":   { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2":   { "$value": "8px" },
    "2-5": { "$value": "10px" },
    "3":   { "$value": "12px" },
    "3-5": { "$value": "14px" },
    "4":   { "$value": "16px" },
    "5":   { "$value": "20px" },
    "6":   { "$value": "24px" },
    "8":   { "$value": "32px" },
    "10":  { "$value": "40px" },
    "12":  { "$value": "48px" },
    "16":  { "$value": "64px" }
  }
}
