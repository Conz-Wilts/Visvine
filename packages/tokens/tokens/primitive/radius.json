{
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px" },
    "xs":   { "$value": "2px" },
    "sm":   { "$value": "4px" },
    "md":   { "$value": "6px", "$description": "Labels and small controls." },
    "lg":   { "$value": "8px", "$description": "Buttons, inputs, menus." },
    "xl":   { "$value": "12px" },
    "2xl":  { "$value": "16px" },
    "3xl":  { "$value": "24px" },
    "full": { "$value": "9999px" }
  }
}
